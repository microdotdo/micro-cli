import "../src/core.ab"
import "../src/project.ab"

fun main: int {
    val secure = microParseApi("https://micro.do/")
    val local = microParseApi("http://127.0.0.1:8080")
    if (!secure.valid || !secure.secure || secure.host != "micro.do" || secure.port != 443) 1
    else if (!local.valid || local.secure || local.port != 8080) 2
    else if (microParseApi("http://micro.do").valid) 3
    else if (!microSlugValid("hello-world")) 4
    else if (microSlugValid("api") || microSlugValid("custom") ||
        microSlugValid("p-private-preview") || microSlugValid("Bad-Slug")) 5
    else if (microBase64UrlEncode("hello") != "aGVsbG8") 6
    else if (!microPathSafe("assets/app.js") || microPathSafe("../secret") ||
        microPathSafe(".hidden")) 7
    else if (microMediaType("index.html") != "text/html; charset=utf-8" ||
        microMediaType("photo.webp") != "image/webp") 8
    else if (microDigest("hello") !=
        "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824") 9
    else if (!microUuidValid("11111111-1111-4111-8111-111111111111")) 10
    else if (microUuidValid("11111111-1111-4111-8111-11111111111z") ||
        microUuidValid("111111111111-4111-8111-111111111111")) 11
    else if (microPositiveInt("2147483647", -1) != 2147483647 ||
        microPositiveInt("2147483648", -1) != -1 || microPositiveInt("0", -1) != -1) 12
    else if (!microDataNameValid("user_notes.2", 48) ||
        microDataNameValid("Bad", 48) || microDataNameValid("", 48)) 13
    else if (!microRecordScopeValid("project") ||
        !microRecordScopeValid("user:11111111-1111-4111-8111-111111111111") ||
        microRecordScopeValid("user:not-a-uuid")) 14
    else if (microNonNegativeInt("0", -1, 100000) != 0 ||
        microNonNegativeInt("100000", -1, 100000) != 100000 ||
        microNonNegativeInt("100001", -1, 100000) != -1) 15
    else if (!microRetentionPolicyValid(0, false) ||
        !microRetentionPolicyValid(30, false) ||
        !microRetentionPolicyValid(3650, true) ||
        microRetentionPolicyValid(0, true) ||
        microRetentionPolicyValid(29, false) ||
        microRetentionPolicyValid(3651, false)) 16
    else if (!microProjectDeletionConfirmationValid(
        "11111111-1111-4111-8111-111111111111", "linked-site", "linked-site", true
    )) 17
    else if (microProjectDeletionConfirmationValid(
        "11111111-1111-4111-8111-111111111111", "linked-site", "other-site", true
    )) 18
    else if (microProjectDeletionConfirmationValid(
        "11111111-1111-4111-8111-111111111111", "linked-site", "linked-site", false
    )) 19
    else if (microProjectDeletionConfirmationValid(
        "not-a-uuid", "linked-site", "linked-site", true
    )) 20
    else if (!microSha256Valid(
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    )) 21
    else if (microSha256Valid(
        "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef"
    ) || microSha256Valid("0123")) 22
    else 0
}
