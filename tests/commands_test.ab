import "../src/commands.ab"

fun contains(value: string, expected: string): bool {
    var found = false
    var index = 0
    while (!found && index + expected.size <= value.size) {
        found = value.slice(index, index + expected.size) == expected
        index = index + 1
    }
    found
}

fun main: int {
    val app = microCli()
    val deploy = app.parse(["deploy", "--help"])
    val restore = app.parse(["backups", "restore", "--help"])
    val upload = app.parse(["files", "upload", "--help"])
    val valid = app.parse(["files", "upload", "asset", "archive.zip", "--entitlement", "downloads", "--json"])
    if (!deploy.succeeded || !contains(deploy.message, "--accept-live-products")) 1
    else if (!restore.succeeded || !contains(restore.message, "<backup-id>") ||
        !contains(restore.message, "--expected-current-sha256")) 2
    else if (!upload.succeeded || !contains(upload.message, "<id> <path>")) 3
    else if (!valid.succeeded || !valid.isCommand("files upload")) 4
    else if (valid.argument(0) != "asset" || valid.value("entitlement") != "downloads") 5
    else if (!valid.has("json")) 6
    else if (app.parse(["files", "upload", "asset"]).succeeded) 7
    else if (app.parse(["backups", "restore", "id", "--backup-sha256", "a"]).succeeded) 8
    else 0
}
