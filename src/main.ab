import "core.ab"
import "project.ab"
import "abla/process/time"

fun microUsage(): string = "micro 0.3.0\n\nBuild and deploy small full-stack sites to micro.do\n\nUsage:\n  micro [--api URL] new <directory> [--json]\n  micro [--api URL] pull <slug> [directory] [--json]\n  micro [--api URL] build [--json]\n  micro [--api URL] signup --email <email> [--password-stdin] [--json]\n  micro [--api URL] login\n  micro [--api URL] logout [--json]\n  micro [--api URL] account status [--wait] [--json]\n  micro [--api URL] deploy --preview [--json]\n  micro [--api URL] deploy <slug> [--json]\n  micro [--api URL] projects [--json]\n  micro [--api URL] status [--json]\n  micro [--api URL] deployments [--json]\n  micro [--api URL] logs [--since 30m] [--json]\n  micro [--api URL] rollback <deployment> [--json]\n  micro [--api URL] products [sync [--accept-price-changes]] [--json]\n  micro [--api URL] files [--json]\n  micro [--api URL] files upload <id> <path> [--entitlement <id>|--public] [--json]\n  micro [--api URL] open\n"

fun microProducts(api: MicroApi): MicroResult = microLinkedRequest(api, "/products")

fun microSyncProducts(api: MicroApi, acceptPriceChanges: bool = false): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!path("micro.yaml").exists())
        return MicroResult(false, "This project does not have micro.yaml.")
    val definitions = microProductDefinitions(path("."))
    if (!definitions.succeeded) return MicroResult(false, definitions.message)
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val syncHeaders: array<HttpHeader> = []
    if (acceptPriceChanges)
        syncHeaders.append(HttpHeader("X-Micro-Accept-Price-Changes", "true"))
    val response = microRequest(
        api,
        "PUT",
        "/api/v1/projects/${project.slug}/products",
        jsonStringify(jsonObject(["products"], [definitions.apiProducts])),
        "application/json",
        credentials.accessToken,
        1048576,
        syncHeaders
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microFiles(api: MicroApi): MicroResult = microLinkedRequest(api, "/files")

fun microUploadFile(
    api: MicroApi,
    stableId: string,
    sourceName: string,
    access: string = "private",
    entitlement: string = ""
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!microProductIdValid(stableId)) return MicroResult(false, "Protected file ID is invalid.")
    if (access == "entitlement" && !microProductIdValid(entitlement))
        return MicroResult(false, "Entitlement ID is invalid.")
    val source = path(sourceName)
    val info = source.info()
    if (!info.isFile() || info.size <= 0 || info.size > 33554432)
        return MicroResult(false, "Protected file must be a regular file from 1 byte through 32 MiB.")
    val contents = source.readText()
    if (contents.size != info.size)
        return MicroResult(false, "Protected file could not be read completely.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api,
        "PUT",
        "/api/v1/projects/${project.slug}/files/$stableId",
        contents,
        microMediaType(sourceName),
        credentials.accessToken,
        1048576,
        [
            HttpHeader("X-Micro-File-Name", source.name()),
            HttpHeader("X-Micro-Access", access),
            HttpHeader("X-Micro-Entitlement", entitlement)
        ]
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microSignup(api: MicroApi, email: string, passwordFromInput: bool): MicroResult {
    val password = microReadSecret(if (passwordFromInput) "" else "Password: ", passwordFromInput)
    if (password.size < 12 || password.size > 256)
        return MicroResult(false, "Password must contain between 12 and 256 characters.")
    if (!passwordFromInput) {
        val confirmation = microReadSecret("Confirm: ")
        if (!microConstantTimeEqual(password, confirmation))
            return MicroResult(false, "Passwords did not match.")
    }
    val registered = microRequest(
        api, "POST", "/api/v1/cli/signup",
        jsonStringify(jsonObject(
            ["email", "password"], [jsonString(email), jsonString(password)]
        ))
    )
    if (!registered.succeeded) return MicroResult(false, registered.message)
    val parsed = jsonParse(registered.response.body)
    val credentials = if (parsed.succeeded && parsed.value.isObject())
        MicroCredentials(
            parsed.value.getString("access_token") != "" &&
                parsed.value.getString("refresh_token") != "",
            parsed.value.getString("access_token"),
            parsed.value.getString("refresh_token")
        )
        else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "The account was created, but credentials could not be saved securely.")
    else MicroResult(
        true,
        "Account created. Check your email to verify it before the first production deployment.",
        jsonStringify(jsonObject(
            ["ok", "authenticated", "email_verified", "verification_sent"],
            [jsonBoolean(true), jsonBoolean(true), jsonBoolean(false), jsonBoolean(true)]
        ))
    )
}

fun microAccountStatus(api: MicroApi, waitForVerification: bool = false): MicroResult {
    var result = MicroResult(false, "Not logged in.")
    var attempts = 0
    var waiting = true
    while (waiting) {
        val credentials = microRefreshCredentials(api)
        if (!credentials.valid) {
            result = MicroResult(false, "Not logged in.")
            waiting = false
        } else {
            val response = microRequest(
                api, "GET", "/api/v1/auth/status", "", "application/json",
                credentials.accessToken
            )
            if (!response.succeeded) {
                result = MicroResult(false, response.message)
                waiting = false
            } else {
                val parsed = jsonParse(response.response.body)
                val verified = parsed.succeeded && parsed.value.isObject() &&
                    parsed.value.get("email_verified").asBoolean()
                result = MicroResult(true, response.response.body, response.response.body)
                attempts = attempts + 1
                waiting = waitForVerification && !verified && attempts < 300
                if (waiting) sleep(1000)
                if (waitForVerification && !verified && attempts >= 300) {
                    result = MicroResult(false, "Email verification timed out.", response.response.body)
                }
            }
        }
    }
    result
}

fun microLogin(api: MicroApi): MicroResult {
    var listener = tcpListenAddress(ipv4SocketAddress("127.0.0.1", 0), 8)
    if (listener.descriptor < 0) return MicroResult(false, "Could not open the loopback callback server.")
    val port = listener.localPort()
    val state = microRandomToken(32)
    val verifier = microRandomToken(48)
    val challenge = microBase64UrlEncode(sha256(verifier))
    if (port <= 0 || state == "" || verifier == "") {
        listener.close()
        return MicroResult(false, "Could not create secure pairing state.")
    }
    val redirect = "http://127.0.0.1:$port/callback"
    val started = microRequest(
        api, "POST", "/api/v1/cli/pair/start",
        jsonStringify(jsonObject(
            ["state", "code_challenge", "redirect_uri"],
            [jsonString(state), jsonString(challenge), jsonString(redirect)]
        ))
    )
    if (!started.succeeded) {
        listener.close()
        return MicroResult(false, started.message)
    }
    val parsed = jsonParse(started.response.body)
    val pairingId = if (parsed.succeeded) parsed.value.getString("pairing_id") else ""
    val authorizeUrl = if (parsed.succeeded) parsed.value.getString("authorize_url") else ""
    if (pairingId == "" || authorizeUrl == "") {
        listener.close()
        return MicroResult(false, "micro.do returned an invalid pairing response.")
    }
    linuxWriteStandardOutputAll("Opening $authorizeUrl\n")
    if (linuxCommand("xdg-open").argument(authorizeUrl).run() != 0)
        linuxWriteStandardOutputAll("Open that URL in your browser to continue.\n")
    val readiness = linuxPollSocket(listener.descriptor, true, false, 300000)
    if (!readiness.readable) {
        listener.close()
        return MicroResult(false, "Browser authorization timed out.")
    }
    val connection = listener.accept()
    listener.close()
    if (connection.descriptor < 0) return MicroResult(false, "Could not accept the browser callback.")
    val callback = httpParseRequest(httpReadRequest(connection, 8192, 0))
    val callbackState = microQueryParameter(callback, "state")
    val callbackPairing = microQueryParameter(callback, "pairing_id")
    val code = microQueryParameter(callback, "code")
    val callbackValid = callback.path == "/callback" && callbackState == state &&
        callbackPairing == pairingId && code != ""
    val callbackBody = if (callbackValid)
        "<!doctype html><title>micro CLI paired</title><p>You can close this window and return to the terminal.</p>"
        else "<!doctype html><title>micro CLI pairing failed</title><p>The callback did not match this pairing request.</p>"
    val callbackResponse = HttpResponse(
        if (callbackValid) 200 else 400,
        [HttpHeader("Content-Type", "text/html; charset=utf-8")],
        callbackBody
    )
    connection.write(callbackResponse.render())
    connection.close()
    if (!callbackValid) return MicroResult(false, "Browser callback state did not match.")
    val exchanged = microRequest(
        api, "POST", "/api/v1/cli/pair/exchange",
        jsonStringify(jsonObject(
            ["pairing_id", "state", "code", "code_verifier"],
            [jsonString(pairingId), jsonString(state), jsonString(code), jsonString(verifier)]
        ))
    )
    if (!exchanged.succeeded) return MicroResult(false, exchanged.message)
    val tokens = jsonParse(exchanged.response.body)
    val credentials = if (tokens.succeeded) MicroCredentials(
        tokens.value.getString("access_token") != "" && tokens.value.getString("refresh_token") != "",
        tokens.value.getString("access_token"), tokens.value.getString("refresh_token")
    ) else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "Could not securely save the paired credentials.")
    else MicroResult(true, "Paired with micro.do.")
}

fun microLogout(): MicroResult {
    val target = microCredentialsPath()
    if (!target.exists()) MicroResult(true, "Already logged out.")
    else if (target.remove()) MicroResult(true, "Removed local micro.do credentials.")
    else MicroResult(false, "Could not remove local credentials.")
}

fun microDeploy(api: MicroApi, slug: string, fileName: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val artifactPath = path(fileName)
    val artifact = artifactPath.readText()
    if (!artifactPath.exists() || artifact == "")
        return MicroResult(false, "Could not read $fileName.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val deployed = microRequest(
        api, "PUT", "/api/v1/functions/$slug", artifact, "application/wasm",
        credentials.accessToken, 1048576
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val deployment = parsed.value.getString("deployment_id")
    val digest = parsed.value.getString("artifact_sha256")
    MicroResult(true, "$url\ndeployment $deployment · sha256 $digest")
}

fun microFunctions(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/functions", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body)
    else MicroResult(false, response.message)
}

fun microDeploySite(api: MicroApi, slug: string, preview: bool): MicroResult {
    if (!preview && !microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val built = microBuildProject(path("."))
    if (!built.succeeded) return built
    val bundle = path(".micro/bundle.json").readText()
    if (bundle == "") return MicroResult(false, "Could not read .micro/bundle.json.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val deploymentHeaders: array<HttpHeader> = []
    if (!preview) {
        val linked = microLocalProject()
        if (linked.valid && linked.slug == slug) {
            val local = jsonParse(path(".micro/project.json").readText())
            if (local.succeeded && local.value.getString("source_sha256") != "")
                deploymentHeaders.append(HttpHeader(
                    "If-Match", local.value.getString("source_sha256")
                ))
        }
    }
    val deployed = microRequest(
        api,
        if (preview) "POST" else "PUT",
        if (preview) "/api/v1/previews" else "/api/v1/projects/$slug/deployments",
        bundle,
        "application/json",
        credentials.accessToken,
        1048576,
        deploymentHeaders
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val bundleDigest = parsed.value.getString("bundle_sha256")
    val sourceDigest = parsed.value.getString("source_sha256")
    if (url == "" || bundleDigest == "" || sourceDigest == "")
        return MicroResult(false, "micro.do omitted deployment identifiers.")
    if (preview) {
        val previewId = parsed.value.getString("preview_id")
        MicroResult(true, "$url\npreview $previewId · bundle $bundleDigest", deployed.response.body)
    } else {
        val projectId = parsed.value.getString("project_id")
        val deploymentId = parsed.value.getString("deployment_id")
        val state = jsonStringify(jsonObject(
            ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
            [jsonString(projectId), jsonString(slug), jsonString(deploymentId),
             jsonString(bundleDigest), jsonString(sourceDigest)]
        ))
        if (!path(".micro/project.json").writeTextAtomic(state))
            return MicroResult(false, "The site deployed, but local project state could not be saved.\n$url\ndeployment $deploymentId")
        if (path("micro.yaml").exists()) {
            val synchronized = microSyncProducts(api)
            if (!synchronized.succeeded)
                return MicroResult(
                    false,
                    "The site deployed, but resource synchronization failed: ${synchronized.message}",
                    jsonStringify(jsonObject(
                        ["ok", "deployment", "resource_sync"],
                        [jsonBoolean(false), parsed.value,
                         jsonObject(["ok", "message"], [jsonBoolean(false), jsonString(synchronized.message)])]
                    ))
                )
        }
        MicroResult(true, "$url\ndeployment $deploymentId · bundle $bundleDigest", deployed.response.body)
    }
}

fun microProjects(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/projects", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

class MicroLocalProject(
    val valid: bool,
    val projectId: string,
    val slug: string,
    val deploymentId: string
)

fun microRestoreBundleFiles(root: Path, files: Json, publicFiles: bool): string {
    if (!files.isArray()) return "The source snapshot has an invalid file list."
    var index = 0
    var error = ""
    while (index < files.size() && error == "") {
        val file = files.at(index)
        val relative = file.getString("path")
        val encoded = file.getString("body_base64")
        val expected = file.getString("sha256")
        if (!file.isObject() || !microPathSafe(relative) || expected.size != 64) {
            error = "The source snapshot contains an unsafe file path."
        } else {
            val contents = base64Decode(encoded)
            if (microDigest(contents) != expected) {
                error = "The source snapshot failed its checksum: $relative"
            } else {
                val target = if (publicFiles) root.child("public").child(relative)
                    else root.child(relative)
                if (!target.createParentDirectories() || !target.writeTextAtomic(contents))
                    error = "Could not restore $relative."
            }
        }
        index = index + 1
    }
    error
}

fun microPullProject(api: MicroApi, slug: string, directory: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    if (directory == "" || directory == "/" || directory == "." || directory == "..")
        return MicroResult(false, "Choose a dedicated pull directory.")
    val root = path(directory)
    if (root.exists() && (!root.info().isDirectory() || root.entries().size > 0))
        return MicroResult(false, "$directory already exists and is not empty.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/projects/$slug/source", "", "application/json",
        credentials.accessToken, 67108864
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid source snapshot.")
    val bundle = parsed.value.get("bundle")
    if (!bundle.isObject()) return MicroResult(false, "micro.do omitted the source bundle.")
    if (!root.createDirectories()) return MicroResult(false, "Could not create $directory.")
    var error = microRestoreBundleFiles(root, bundle.get("source"), false)
    if (error == "") error = microRestoreBundleFiles(root, bundle.get("assets"), true)
    if (error != "") return MicroResult(false, error)
    val state = jsonStringify(jsonObject(
        ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
        [jsonString(parsed.value.getString("project_id")), jsonString(slug),
         jsonString(parsed.value.getString("deployment_id")),
         jsonString(parsed.value.getString("bundle_sha256")),
         jsonString(parsed.value.getString("source_sha256"))]
    ))
    if (!root.child(".micro/project.json").writeTextAtomic(state))
        return MicroResult(false, "Source was restored, but local project state could not be saved.")
    MicroResult(
        true,
        "Pulled $slug into $directory",
        jsonStringify(jsonObject(
            ["ok", "slug", "directory", "project_id", "deployment_id", "source_sha256"],
            [jsonBoolean(true), jsonString(slug), jsonString(directory),
             jsonString(parsed.value.getString("project_id")),
             jsonString(parsed.value.getString("deployment_id")),
             jsonString(parsed.value.getString("source_sha256"))]
        ))
    )
}

fun microLocalProject(): MicroLocalProject {
    val parsed = jsonParse(path(".micro/project.json").readText())
    if (parsed.succeeded && parsed.value.isObject()) {
        val projectId = parsed.value.getString("project_id")
        val slug = parsed.value.getString("slug")
        MicroLocalProject(
            projectId != "" && microSlugValid(slug),
            projectId,
            slug,
            parsed.value.getString("deployment_id")
        )
    } else MicroLocalProject(false, "", "", "")
}

fun microLinkedRequest(
    api: MicroApi,
    endpoint: string,
    method: string = "GET"
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api,
        method,
        "/api/v1/projects/${project.slug}$endpoint",
        "",
        "application/json",
        credentials.accessToken
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microDurationSeconds(value: string): int {
    if (value.size < 2) return 0
    val unit = value[value.size - 1]
    val number = microParsePort(value.slice(0, value.size - 1), 0)
    if (unit == 109) number * 60
    else if (unit == 104) number * 3600
    else if (unit == 100) number * 86400
    else 0
}

fun microProjectStatus(api: MicroApi): MicroResult = microLinkedRequest(api, "")

fun microProjectDeployments(api: MicroApi): MicroResult =
    microLinkedRequest(api, "/deployments")

fun microProjectLogs(api: MicroApi, since: string): MicroResult {
    val seconds = microDurationSeconds(since)
    if (seconds < 60 || seconds > 604800)
        return MicroResult(false, "--since must be 1m through 7d.")
    microLinkedRequest(api, "/logs?since_seconds=$seconds")
}

fun microProjectRollback(api: MicroApi, deployment: string): MicroResult {
    if (deployment.size != 36)
        return MicroResult(false, "Deployment ID must be a UUID.")
    val activated = microLinkedRequest(
        api,
        "/deployments/$deployment/activate",
        "POST"
    )
    if (!activated.succeeded) return activated
    val parsed = jsonParse(activated.structured)
    if (parsed.succeeded && parsed.value.isObject()) {
        val current = microLocalProject()
        if (current.valid) {
            val updated = jsonStringify(jsonObject(
                ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
                [jsonString(current.projectId), jsonString(current.slug), jsonString(deployment),
                 jsonString(parsed.value.getString("bundle_sha256")),
                 jsonString(parsed.value.getString("source_sha256"))]
            ))
            if (!path(".micro/project.json").writeTextAtomic(updated))
                return MicroResult(false, "Rollback succeeded remotely, but local state could not be updated.", activated.structured)
        }
    }
    activated
}

fun microOpenProject(): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val url = "https://${project.slug}.micro.do"
    if (linuxCommand("xdg-open").argument(url).run() == 0)
        MicroResult(true, "Opened $url", jsonStringify(jsonObject(
            ["ok", "url"], [jsonBoolean(true), jsonString(url)]
        )))
    else MicroResult(false, "Could not open $url.")
}

class MicroCommandResult(val result: MicroResult, val json: bool)

fun microRun(): MicroCommandResult {
    var count = linuxArgumentCount()
    val jsonOutput = count > 0 && linuxArgument(count - 1) == "--json"
    if (jsonOutput) count = count - 1
    var apiValue = "https://micro.do"
    val configured = linuxEnvironment("MICRO_API")
    if (configured.found && configured.value != "") apiValue = configured.value
    var index = 0
    if (index < count && linuxArgument(index) == "--api") {
        if (index + 1 >= count) return MicroCommandResult(MicroResult(false, "--api requires a URL.\n${microUsage()}"), jsonOutput)
        apiValue = linuxArgument(index + 1)
        index = index + 2
    }
    if (index >= count || linuxArgument(index) == "--help" || linuxArgument(index) == "-h")
        return MicroCommandResult(MicroResult(true, microUsage()), jsonOutput)
    if (linuxArgument(index) == "--version" || linuxArgument(index) == "-V")
        return MicroCommandResult(MicroResult(true, "micro 0.3.0"), jsonOutput)
    val api = microParseApi(apiValue)
    if (!api.valid) return MicroCommandResult(MicroResult(false, api.message), jsonOutput)
    val command = linuxArgument(index)
    val result = if (command == "new" && index + 2 == count)
        microNewProject(linuxArgument(index + 1))
    else if (command == "pull" && index + 2 == count)
        microPullProject(api, linuxArgument(index + 1), linuxArgument(index + 1))
    else if (command == "pull" && index + 3 == count)
        microPullProject(api, linuxArgument(index + 1), linuxArgument(index + 2))
    else if (command == "build" && index + 1 == count)
        microBuildProject(path("."))
    else if (command == "signup" && index + 3 == count &&
        linuxArgument(index + 1) == "--email")
        microSignup(api, linuxArgument(index + 2), false)
    else if (command == "signup" && index + 4 == count &&
        linuxArgument(index + 1) == "--email" &&
        linuxArgument(index + 3) == "--password-stdin")
        microSignup(api, linuxArgument(index + 2), true)
    else if (command == "account" && index + 2 == count &&
        linuxArgument(index + 1) == "status")
        microAccountStatus(api)
    else if (command == "account" && index + 3 == count &&
        linuxArgument(index + 1) == "status" &&
        linuxArgument(index + 2) == "--wait")
        microAccountStatus(api, true)
    else if (command == "login" && index + 1 == count) microLogin(api)
    else if (command == "logout" && index + 1 == count) microLogout()
    else if (command == "projects" && index + 1 == count) microProjects(api)
    else if (command == "deploy" && index + 2 == count &&
        linuxArgument(index + 1) == "--preview")
        microDeploySite(api, "", true)
    else if (command == "deploy" && index + 2 == count)
        microDeploySite(api, linuxArgument(index + 1), false)
    else if (command == "status" && index + 1 == count) microProjectStatus(api)
    else if (command == "deployments" && index + 1 == count) microProjectDeployments(api)
    else if (command == "logs" && index + 3 == count &&
        linuxArgument(index + 1) == "--since")
        microProjectLogs(api, linuxArgument(index + 2))
    else if (command == "rollback" && index + 2 == count)
        microProjectRollback(api, linuxArgument(index + 1))
    else if (command == "products" && index + 1 == count) microProducts(api)
    else if (command == "products" && index + 2 == count &&
        linuxArgument(index + 1) == "sync") microSyncProducts(api)
    else if (command == "products" && index + 3 == count &&
        linuxArgument(index + 1) == "sync" &&
        linuxArgument(index + 2) == "--accept-price-changes")
        microSyncProducts(api, true)
    else if (command == "files" && index + 1 == count) microFiles(api)
    else if (command == "files" && index + 4 == count &&
        linuxArgument(index + 1) == "upload")
        microUploadFile(api, linuxArgument(index + 2), linuxArgument(index + 3))
    else if (command == "files" && index + 6 == count &&
        linuxArgument(index + 1) == "upload" &&
        linuxArgument(index + 4) == "--entitlement")
        microUploadFile(
            api, linuxArgument(index + 2), linuxArgument(index + 3),
            "entitlement", linuxArgument(index + 5)
        )
    else if (command == "files" && index + 5 == count &&
        linuxArgument(index + 1) == "upload" &&
        linuxArgument(index + 4) == "--public")
        microUploadFile(api, linuxArgument(index + 2), linuxArgument(index + 3), "public")
    else if (command == "open" && index + 1 == count) microOpenProject()
    else MicroResult(false, "Invalid command.\n${microUsage()}")
    MicroCommandResult(result, jsonOutput)
}

fun main: int {
    val command = microRun()
    val result = command.result
    val output = if (command.json && result.structured != "") result.structured
        else if (command.json) jsonStringify(jsonObject(
            ["ok", "message"], [jsonBoolean(result.succeeded), jsonString(result.message)]
        ))
        else result.message
    if (result.succeeded) {
        linuxWriteStandardOutputAll("$output\n")
        0
    } else {
        if (command.json) linuxWriteStandardOutputAll("$output\n")
        else linuxWriteStandardErrorAll("micro: ${result.message}\n")
        1
    }
}
