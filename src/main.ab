        linuxArgument(index + 1) == "disable")
        microDisableUser(api, linuxArgument(index + 2), false)
    else if (command == "users" && index + 3 == count &&
        linuxArgument(index + 1) == "enable")
        microEnableUser(api, linuxArgument(index + 2))
    else if (command == "users" && index + 4 == count &&
        linuxArgument(index + 1) == "revoke-sessions" &&
        linuxArgument(index + 3) == "--confirm")
        microRevokeUserSessions(api, linuxArgument(index + 2), true)
    else if (command == "users" && index + 3 == count &&
        linuxArgument(index + 1) == "revoke-sessions")
        microRevokeUserSessions(api, linuxArgument(index + 2), false)
    else if (command == "records" && index + 1 == count) microRecords(api)
    else if (command == "records" && index + 9 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 6) == "--version" &&
        linuxArgument(index + 8) == "--confirm")
        microDeleteRecord(
            api, linuxArgument(index + 2), linuxArgument(index + 3),
            linuxArgument(index + 4), linuxArgument(index + 5),
            microPositiveInt(linuxArgument(index + 7), -1), true
        )
    else if (command == "records" && index + 8 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 6) == "--version")
        microDeleteRecord(
            api, linuxArgument(index + 2), linuxArgument(index + 3),
            linuxArgument(index + 4), linuxArgument(index + 5),
            microPositiveInt(linuxArgument(index + 7), -1), false
        )
    else if (command == "backups" && index + 1 == count) microBackups(api)
    else if (command == "backups" && index + 3 == count &&
        linuxArgument(index + 1) == "create" &&
        linuxArgument(index + 2) == "--confirm")
        microCreateBackup(api, true)
    else if (command == "backups" && index + 2 == count &&
        linuxArgument(index + 1) == "create")
        microCreateBackup(api, false)
    else if (command == "backups" && index + 8 == count &&
        linuxArgument(index + 1) == "restore" &&
        linuxArgument(index + 3) == "--backup-sha256" &&
        linuxArgument(index + 5) == "--expected-current-sha256" &&
        linuxArgument(index + 7) == "--confirm")
        microRestoreBackup(
            api, linuxArgument(index + 2), linuxArgument(index + 4),
            linuxArgument(index + 6), true
        )
    else if (command == "backups" && index + 7 == count &&
        linuxArgument(index + 1) == "restore" &&
        linuxArgument(index + 3) == "--backup-sha256" &&
        linuxArgument(index + 5) == "--expected-current-sha256")
        microRestoreBackup(
            api, linuxArgument(index + 2), linuxArgument(index + 4),
            linuxArgument(index + 6), false
        )
    else if (command == "backups" && index + 6 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 3) == "--sha256" &&
        linuxArgument(index + 5) == "--confirm")
        microDeleteBackup(
            api, linuxArgument(index + 2), linuxArgument(index + 4), true
        )
    else if (command == "backups" && index + 5 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 3) == "--sha256")
        microDeleteBackup(
            api, linuxArgument(index + 2), linuxArgument(index + 4), false
        )
    else if (command == "purchases" && index + 1 == count) microPurchases(api)
    else if (command == "audit" && index + 1 == count) microAudit(api)
    else if (command == "export" && index + 1 == count) microExport(api)
    else if (command == "export" && index + 2 == count)
        microExport(api, linuxArgument(index + 1))
    else if (command == "export" && index + 6 == count &&
        linuxArgument(index + 2) == "--limit" &&
        linuxArgument(index + 4) == "--offset")
        microExport(
            api, linuxArgument(index + 1),
            microPositiveInt(linuxArgument(index + 3), -1, 100),
            microNonNegativeInt(linuxArgument(index + 5), -1, 100000)
        )
    else if (command == "retention" && index + 1 == count) microRetention(api)
    else if (command == "retention" && index + 5 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--record-days" &&
        linuxArgument(index + 4) == "--confirm")
        microSetRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 3650), false, true)
    else if (command == "retention" && index + 6 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--record-days" &&
        linuxArgument(index + 4) == "--automatic" &&
        linuxArgument(index + 5) == "--confirm")
        microSetRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 3650), true, true)
    else if (command == "retention" && index + 4 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--record-days")
        microSetRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 3650), false, false)
    else if (command == "retention" && index + 5 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--record-days" &&
        linuxArgument(index + 4) == "--automatic")
        microSetRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 3650), true, false)
    else if (command == "retention" && index + 5 == count &&
        linuxArgument(index + 1) == "prune" &&
        linuxArgument(index + 2) == "--expected-records" &&
        linuxArgument(index + 4) == "--confirm")
        microPruneRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 10000), true)
    else if (command == "retention" && index + 4 == count &&
        linuxArgument(index + 1) == "prune" &&
        linuxArgument(index + 2) == "--expected-records")
        microPruneRetention(api, microNonNegativeInt(linuxArgument(index + 3), -1, 10000), false)
    else if (command == "rollback" && index + 2 == count)
        microProjectRollback(api, linuxArgument(index + 1))
    else if (command == "products" && index + 1 == count) microProducts(api)
    else if (command == "products" && index + 2 == count &&
        linuxArgument(index + 1) == "sync") microSyncProducts(api)
    else if (command == "products" && index + 3 == count &&
        linuxArgument(index + 1) == "sync" &&
        linuxArgument(index + 2) == "--accept-price-changes")
        microSyncProducts(api, true)
    else if (command == "products" && index + 3 == count &&
        linuxArgument(index + 1) == "sync" &&
        linuxArgument(index + 2) == "--accept-live-products")
        microSyncProducts(api, false, true)
    else if (command == "products" && index + 4 == count &&
        linuxArgument(index + 1) == "sync" &&
        linuxArgument(index + 2) == "--accept-price-changes" &&
        linuxArgument(index + 3) == "--accept-live-products")
        microSyncProducts(api, true, true)
    else if (command == "files" && index + 1 == count) microFiles(api)
    else if (command == "files" && index + 4 == count &&
        linuxArgument(index + 1) == "upload")
        microUploadFile(api, linuxArgument(index + 2), linuxArgument(index + 3))
    else if (command == "files" && index + 6 == count &&
        linuxArgument(index + 1) == "upload" &&
        linuxArgument(index + 4) == "--entitlement")
        microUploadFile(
            api, linuxArgument(index + 2), linuxArgument(index + 3),
            "entitlement", linuxArgument(index + 5)
        )
    else if (command == "files" && index + 5 == count &&
        linuxArgument(index + 1) == "upload" &&
        linuxArgument(index + 4) == "--public")
        microUploadFile(api, linuxArgument(index + 2), linuxArgument(index + 3), "public")
    else if (command == "github" && index + 10 == count &&
        linuxArgument(index + 1) == "link" &&
        linuxArgument(index + 2) == "--repository" &&
        linuxArgument(index + 4) == "--environment" &&
        linuxArgument(index + 6) == "--ref" &&
        linuxArgument(index + 8) == "--slug")
        microGithubLink(
            api, linuxArgument(index + 3), linuxArgument(index + 5),
            linuxArgument(index + 7), linuxArgument(index + 9)
        )
    else if (command == "github" && index + 2 == count &&
        linuxArgument(index + 1) == "bindings") microGithubBindings(api)
    else if (command == "github" && index + 3 == count &&
        linuxArgument(index + 1) == "revoke")
        microGithubRevoke(api, linuxArgument(index + 2))
    else if (command == "open" && index + 1 == count) microOpenProject()
    else MicroResult(false, "Invalid command.\n${microUsage()}")
    MicroCommandResult(result, jsonOutput)
}

fun main: int {
    val command = microRun()
    val result = command.result
    val output = if (command.json && result.structured != "") result.structured
        else if (command.json) jsonStringify(jsonObject(
            ["ok", "message"], [jsonBoolean(result.succeeded), jsonString(result.message)]
        ))
        else result.message
    if (result.succeeded) {
        linuxWriteStandardOutputAll("$output\n")
        0
    } else {
        if (command.json) linuxWriteStandardOutputAll("$output\n")
        else linuxWriteStandardErrorAll("micro: ${result.message}\n")
        1
    }
}
