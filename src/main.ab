}

fun microDeleteProject(
    api: MicroApi,
    confirmedSlug: string,
    confirmed: bool
): MicroResult {
    if (!confirmed)
        return MicroResult(false, "Project deletion requires --confirm and the exact linked slug with --confirm-slug.")
    val project = microLocalProject()
    if (!project.valid || !microUuidValid(project.projectId))
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!microProjectDeletionConfirmationValid(
        project.projectId, project.slug, confirmedSlug, confirmed
    )) return MicroResult(
        false,
        "--confirm-slug must exactly match the linked slug '${project.slug}'; nothing was deleted."
    )
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "DELETE", "/api/v1/projects/${project.slug}",
        jsonStringify(jsonObject(
            ["project_id", "slug"],
            [jsonString(project.projectId), jsonString(project.slug)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Project-Delete", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !microUuidValid(parsed.value.getString("id")))
        return MicroResult(false, "micro.do returned an invalid project-deletion receipt.")
    val receiptId = parsed.value.getString("id")
    val status = parsed.value.getString("status")
    MicroResult(
        true,
        "Project ${project.slug} is hidden and deletion receipt $receiptId is $status. The remote slug is reserved for 30 days; local source was not removed.",
        response.response.body
    )
}

class MicroLocalProject(
    val valid: bool,
    val projectId: string,
    val slug: string,
    val deploymentId: string
)

fun microRestoreBundleFiles(root: Path, files: Json, publicFiles: bool): string {
    if (!files.isArray()) return "The source snapshot has an invalid file list."
    var index = 0
    var error = ""
    while (index < files.size() && error == "") {
        val file = files.at(index)
        val relative = file.getString("path")
        val encoded = file.getString("body_base64")
        val expected = file.getString("sha256")
        if (!file.isObject() || !microPathSafe(relative) || expected.size != 64) {
            error = "The source snapshot contains an unsafe file path."
        } else {
            val contents = base64Decode(encoded)
            if (microDigest(contents) != expected) {
                error = "The source snapshot failed its checksum: $relative"
            } else {
                val target = if (publicFiles) root.child("public").child(relative)
                    else root.child(relative)
                if (!target.createParentDirectories() || !target.writeTextAtomic(contents))
                    error = "Could not restore $relative."
            }
        }
        index = index + 1
    }
    error
}

fun microPullProject(api: MicroApi, slug: string, directory: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    if (directory == "" || directory == "/" || directory == "." || directory == "..")
        return MicroResult(false, "Choose a dedicated pull directory.")
    val root = path(directory)
    if (root.exists() && (!root.info().isDirectory() || root.entries().size > 0))
        return MicroResult(false, "$directory already exists and is not empty.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/projects/$slug/source", "", "application/json",
        credentials.accessToken, 67108864
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid source snapshot.")
    val bundle = parsed.value.get("bundle")
    if (!bundle.isObject()) return MicroResult(false, "micro.do omitted the source bundle.")
    if (!root.createDirectories()) return MicroResult(false, "Could not create $directory.")
    var error = microRestoreBundleFiles(root, bundle.get("source"), false)
    if (error == "") error = microRestoreBundleFiles(root, bundle.get("assets"), true)
    if (error != "") return MicroResult(false, error)
    val state = jsonStringify(jsonObject(
        ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
        [jsonString(parsed.value.getString("project_id")), jsonString(slug),
         jsonString(parsed.value.getString("deployment_id")),
         jsonString(parsed.value.getString("bundle_sha256")),
         jsonString(parsed.value.getString("source_sha256"))]
    ))
    if (!root.child(".micro/project.json").writeTextAtomic(state))
        return MicroResult(false, "Source was restored, but local project state could not be saved.")
    MicroResult(
        true,
        "Pulled $slug into $directory",
        jsonStringify(jsonObject(
            ["ok", "slug", "directory", "project_id", "deployment_id", "source_sha256"],
            [jsonBoolean(true), jsonString(slug), jsonString(directory),
             jsonString(parsed.value.getString("project_id")),
             jsonString(parsed.value.getString("deployment_id")),
             jsonString(parsed.value.getString("source_sha256"))]
        ))
    )
}

fun microGallery(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/gallery", "", "application/json", "", 1048576)
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.gallery.v1" ||
        !parsed.value.get("entries").isArray())
        return MicroResult(false, "micro.do returned an invalid gallery.")
    val entries = parsed.value.get("entries")
    var message = if (entries.size() == 0) "No curated Micros are published yet." else "Curated Micros:"
    var index = 0
    while (index < entries.size()) {
        val entry = entries.at(index)
        val id = entry.getString("id")
        val title = entry.getString("title")
        val license = entry.getString("license")
        if (!entry.isObject() || !microGalleryEntryIdValid(id) || title == "" || license == "")
            return MicroResult(false, "micro.do returned an invalid gallery entry.")
        message = "$message\n  $id · $title · $license"
        index = index + 1
    }
    MicroResult(true, message, response.response.body)
}

fun microRemix(api: MicroApi, entryId: string, directory: string): MicroResult {
    if (!microGalleryEntryIdValid(entryId))
        return MicroResult(false, "Gallery entry must be 3-64 lowercase letters, digits, or hyphens.")
    if (directory == "" || directory == "/" || directory == "." || directory == ".." ||
        !microPathSafe(directory))
        return MicroResult(false, "Choose a safe dedicated remix directory.")
    val root = path(directory)
    if (root.exists() && (!root.info().isDirectory() || root.entries().size > 0))
        return MicroResult(false, "$directory already exists and is not empty.")
    val response = microRequest(
        api, "GET", "/api/v1/gallery/$entryId", "", "application/json", "", 67108864
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.gallery-source.v1")
        return MicroResult(false, "micro.do returned an invalid curated source snapshot.")
    val entry = parsed.value.get("entry")
    val bundle = parsed.value.get("bundle")
    val copyPolicy = entry.get("copy_policy")
    val sourceDeployment = entry.getString("source_deployment")
    val bundleSha = entry.getString("bundle_sha256")
    val sourceSha = entry.getString("source_sha256")
    val consentRecorded = entry.get("consent_recorded")
    if (!entry.isObject() || entry.getString("id") != entryId ||
        !microUuidValid(sourceDeployment) || !microSha256Valid(bundleSha) ||
        !microSha256Valid(sourceSha) ||
        entry.getString("terms_version") != "micro.gallery.v1" ||
        !consentRecorded.isBoolean() || !consentRecorded.asBoolean() ||
        !bundle.isObject() ||
        !copyPolicy.isObject() ||
        copyPolicy.getString("version") != "micro.gallery-copy.v1")
        return MicroResult(false, "micro.do returned incomplete remix provenance.")
    if (!root.createDirectories()) return MicroResult(false, "Could not create $directory.")
    var error = microRestoreBundleFiles(root, bundle.get("source"), false)
    if (error == "") error = microRestoreBundleFiles(root, bundle.get("assets"), true)
    if (error != "") return MicroResult(false, error)
    if (!microRemoveRemixSlug(root))
        return MicroResult(false, "Source was restored, but its source slug could not be removed.")
    val provenance = jsonStringify(jsonObject(
        ["schema", "entry", "title", "creator", "license", "source_project",
         "source_deployment", "bundle_sha256", "source_sha256", "terms_version",
         "consent_recorded", "curated_at", "copy_policy"],
        [jsonString("micro.remix.v1"), jsonString(entryId),
         jsonString(entry.getString("title")), jsonString(entry.getString("creator")),
         jsonString(entry.getString("license")),
         jsonString(entry.getString("source_project")),
         jsonString(sourceDeployment), jsonString(bundleSha), jsonString(sourceSha),
         jsonString(entry.getString("terms_version")), jsonBoolean(true),
         jsonString(entry.getString("curated_at")), copyPolicy]
    ))
    if (!root.child(".micro").createDirectories() ||
        !root.child(".micro/remix.json").writeTextAtomic(provenance))
        return MicroResult(false, "Source was restored, but remix provenance could not be saved.")
    MicroResult(
        true,
        "Remixed ${entry.getString("title")} into $directory. No project or slug was created; review it and run `micro dev`.",
        jsonStringify(jsonObject(
            ["ok", "entry", "directory", "source_sha256", "project_created", "slug_reserved"],
            [jsonBoolean(true), jsonString(entryId), jsonString(directory),
             jsonString(sourceSha), jsonBoolean(false), jsonBoolean(false)]
        ))
    )
}

fun microLocalProject(): MicroLocalProject {
    val parsed = jsonParse(path(".micro/project.json").readText())
    if (parsed.succeeded && parsed.value.isObject()) {
        val projectId = parsed.value.getString("project_id")
        val slug = parsed.value.getString("slug")
        MicroLocalProject(
            projectId != "" && microSlugValid(slug),
            projectId,
            slug,
            parsed.value.getString("deployment_id")
        )
    } else MicroLocalProject(false, "", "", "")
}

fun microLinkedRequest(
    api: MicroApi,
    endpoint: string,
    method: string = "GET"
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api,
        method,
        "/api/v1/projects/${project.slug}$endpoint",
        "",
        "application/json",
        credentials.accessToken
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microAuthenticatedRequest(
    api: MicroApi,
    method: string,
    endpoint: string,
    body: string = "",
    successMessage: string = ""
): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, method, endpoint, body, "application/json", credentials.accessToken
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val message = if (response.response.body != "") response.response.body else successMessage
    MicroResult(true, message, response.response.body)
}

fun microLinkedOperation(
    api: MicroApi,
    method: string,
    endpoint: string,
    body: string = "",
    successMessage: string = ""
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    microAuthenticatedRequest(
        api, method, "/api/v1/projects/${project.slug}$endpoint", body, successMessage
    )
}

fun microProjectRoleValid(role: string): bool =
    role == "viewer" || role == "developer" || role == "admin"

fun microPlans(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/plans")
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microPlatformStatus(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/status")
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    val status = if (parsed.succeeded) parsed.value.getString("status") else ""
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.status.v1" ||
        (status != "operational" && status != "degraded" && status != "major_outage") ||
        !parsed.value.get("components").isArray() ||
        !parsed.value.get("incidents").isArray())
        return MicroResult(false, "micro.do returned an invalid platform-status response.")
    MicroResult(true, response.response.body, response.response.body)
}

fun microUsageStatus(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "GET", "/api/v1/usage")

fun microSetSpendingCap(
    api: MicroApi,
    monthlyCents: int,
    warningPercent: int,
    hardStop: bool
): MicroResult {
    if (monthlyCents < 0 || monthlyCents > 1000000 ||
        warningPercent < 1 || warningPercent > 100)
        return MicroResult(false, "Monthly cents must be 0 through 1000000 and warning percent 1 through 100.")
    microAuthenticatedRequest(
        api, "PUT", "/api/v1/spending-cap",
        jsonStringify(jsonObject(
            ["monthly_usage_cap_cents", "warning_percent", "hard_stop"],
            [jsonInteger(monthlyCents), jsonInteger(warningPercent), jsonBoolean(hardStop)]
        ))
    )
}

fun microDeleteSpendingCap(api: MicroApi, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing the spending cap requires --confirm.")
    microAuthenticatedRequest(
        api, "DELETE", "/api/v1/spending-cap", "", "Removed the account spending cap."
    )
}

fun microBillingStatus(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "GET", "/api/v1/billing")

fun microBillingCheckout(api: MicroApi, planId: string): MicroResult {
    if (!microProductIdValid(planId)) return MicroResult(false, "Plan ID is invalid.")
    microAuthenticatedRequest(
        api, "POST", "/api/v1/billing/checkout",
        jsonStringify(jsonObject(["plan_id"], [jsonString(planId)]))
    )
}

fun microBillingPortal(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "POST", "/api/v1/billing/portal", "{}")

fun microProjectSettings(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/settings")

fun microSetProjectVisibility(
    api: MicroApi,
    visibility: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Changing project visibility requires --confirm.")
    if (visibility != "public" && visibility != "private")
        return MicroResult(false, "Visibility must be public or private.")
    microLinkedOperation(
        api, "PUT", "/settings",
        jsonStringify(jsonObject(["visibility"], [jsonString(visibility)]))
    )
}

fun microProjectMembers(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/members")

fun microSetProjectMember(
    api: MicroApi,
    email: string,
    role: string,
    canPromote: bool
): MicroResult {
    if (!microProjectRoleValid(role) || (role == "viewer" && canPromote))
        return MicroResult(false, "Role must be viewer, developer, or admin; viewers cannot promote.")
    microLinkedOperation(
        api, "PUT", "/members",
        jsonStringify(jsonObject(
            ["email", "role", "can_promote"],
            [jsonString(email), jsonString(role), jsonBoolean(canPromote)]
        ))
    )
}

fun microRemoveProjectMember(api: MicroApi, accountId: string, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing a project member requires --confirm.")
    if (!microUuidValid(accountId)) return MicroResult(false, "Project member ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/members/$accountId", "", "Removed the project member."
    )
}

fun microProjectInvitations(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/invitations")

fun microCreateProjectInvitation(
    api: MicroApi,
    email: string,
    role: string,
    canPromote: bool
): MicroResult {
    if (!microProjectRoleValid(role) || (role == "viewer" && canPromote))
        return MicroResult(false, "Role must be viewer, developer, or admin; viewers cannot promote.")
    microLinkedOperation(
        api, "POST", "/invitations",
        jsonStringify(jsonObject(
            ["email", "role", "can_promote"],
            [jsonString(email), jsonString(role), jsonBoolean(canPromote)]
        ))
    )
}

fun microRevokeProjectInvitation(
    api: MicroApi,
    invitationId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Revoking a project invitation requires --confirm.")
    if (!microUuidValid(invitationId)) return MicroResult(false, "Invitation ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/invitations/$invitationId", "", "Revoked the project invitation."
    )
}

fun microAcceptProjectInvitation(api: MicroApi, tokenFromStdin: bool): MicroResult {
    if (!tokenFromStdin)
        return MicroResult(false, "Invitation tokens must be supplied with --token-stdin.")
    val token = microReadSecret("", true)
    if (token.size < 32 || token.size > 256)
        return MicroResult(false, "The invitation token is invalid.")
    microAuthenticatedRequest(
        api, "POST", "/api/v1/invitations/accept",
        jsonStringify(jsonObject(["token"], [jsonString(token)]))
    )
}

fun microProjectDomains(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/domains")

fun microAddProjectDomain(api: MicroApi, hostname: string): MicroResult =
    microLinkedOperation(
        api, "POST", "/domains",
        jsonStringify(jsonObject(["hostname"], [jsonString(hostname)]))
    )

fun microVerifyProjectDomain(api: MicroApi, domainId: string): MicroResult {
    if (!microUuidValid(domainId)) return MicroResult(false, "Domain ID must be a UUID.")
    microLinkedOperation(api, "POST", "/domains/$domainId/verify", "{}")
}

fun microRemoveProjectDomain(api: MicroApi, domainId: string, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing a custom domain requires --confirm.")
    if (!microUuidValid(domainId)) return MicroResult(false, "Domain ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/domains/$domainId", "", "Removed the custom domain."
    )
}

fun microProjectPrivateGrants(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/private-grants")

fun microCreateProjectPrivateGrant(
    api: MicroApi,
    expiresDays: int,
    label: string
): MicroResult {
    if (expiresDays < 1 || expiresDays > 365 || label.size > 120)
        return MicroResult(false, "Private grants must expire in 1 through 365 days and labels may use 120 bytes.")
    microLinkedOperation(
        api, "POST", "/private-grants",
        jsonStringify(jsonObject(
            ["expires_in_days", "label"], [jsonInteger(expiresDays), jsonString(label)]
        ))
    )
}

fun microRevokeProjectPrivateGrant(
    api: MicroApi,
    grantId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Revoking a private access grant requires --confirm.")
    if (!microUuidValid(grantId)) return MicroResult(false, "Private grant ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/private-grants/$grantId", "", "Revoked the private access grant."
    )
}

fun microProjectSchedules(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/schedules")

fun microProjectEmails(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/emails")

fun microSetProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    everyMinutes: int,
    payloadFile: string = "",
    enabled: bool = true
): MicroResult {
    if (!microScheduleIdValid(scheduleId) || !microScheduleIntervalValid(everyMinutes))
        return MicroResult(false, "Use a valid schedule ID and a 5 through 10080 minute interval.")
    var payloadText = "{}"
    if (payloadFile != "") {
        val source = path(payloadFile)
        val info = source.info()
        if (!info.isFile() || info.size < 2 || info.size > 8192)
            return MicroResult(false, "Schedule payload file must be regular JSON from 2 bytes through 8 KiB.")
        payloadText = source.readText()
    }
    if (!microSchedulePayloadValid(payloadText))
        return MicroResult(false, "Schedule payload must be a JSON object up to 8 KiB; never use it for credentials.")
    val payload = jsonParse(payloadText).value
    microLinkedOperation(
        api, "PUT", "/schedules",
        jsonStringify(jsonObject(
            ["id", "every_minutes", "payload", "enabled"],
            [jsonString(scheduleId), jsonInteger(everyMinutes), payload,
             jsonBoolean(enabled)]
        ))
    )
}

fun microRunProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Running a project schedule requires --confirm.")
    if (!microScheduleIdValid(scheduleId)) return MicroResult(false, "Schedule ID is invalid.")
    microLinkedOperation(api, "POST", "/schedules/$scheduleId/run", "{}")
}

fun microRemoveProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing a project schedule requires --confirm.")
    if (!microScheduleIdValid(scheduleId)) return MicroResult(false, "Schedule ID is invalid.")
    microLinkedOperation(
        api, "DELETE", "/schedules/$scheduleId", "", "Removed the project schedule."
    )
}

fun microDurationSeconds(value: string): int {
    if (value.size < 2) return 0
    val unit = value[value.size - 1]
    val number = microParsePort(value.slice(0, value.size - 1), 0)
    if (unit == 109) number * 60
    else if (unit == 104) number * 3600
    else if (unit == 100) number * 86400
    else 0
}

fun microProjectStatus(api: MicroApi): MicroResult = microLinkedRequest(api, "")

fun microProjectDeployments(api: MicroApi): MicroResult =
    microLinkedRequest(api, "/deployments")

fun microProjectLogs(api: MicroApi, since: string): MicroResult {
    val seconds = microDurationSeconds(since)
    if (seconds < 60 || seconds > 604800)
        return MicroResult(false, "--since must be 1m through 7d.")
    microLinkedRequest(api, "/logs?since_seconds=$seconds")
}

fun microProjectRollback(api: MicroApi, deployment: string): MicroResult {
    if (deployment.size != 36)
        return MicroResult(false, "Deployment ID must be a UUID.")
    val activated = microLinkedRequest(
        api,
        "/deployments/$deployment/activate",
        "POST"
    )
    if (!activated.succeeded) return activated
    val parsed = jsonParse(activated.structured)
    if (parsed.succeeded && parsed.value.isObject()) {
        val current = microLocalProject()
        if (current.valid) {
            val updated = jsonStringify(jsonObject(
                ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
                [jsonString(current.projectId), jsonString(current.slug), jsonString(deployment),
                 jsonString(parsed.value.getString("bundle_sha256")),
                 jsonString(parsed.value.getString("source_sha256"))]
            ))
            if (!path(".micro/project.json").writeTextAtomic(updated))
                return MicroResult(false, "Rollback succeeded remotely, but local state could not be updated.", activated.structured)
        }
    }
    activated
}

fun microOpenProject(): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val url = "https://${project.slug}.micro.do"
    if (linuxCommand("xdg-open").argument(url).run() == 0)
        MicroResult(true, "Opened $url", jsonStringify(jsonObject(
            ["ok", "url"], [jsonBoolean(true), jsonString(url)]
        )))
    else MicroResult(false, "Could not open $url.")
}

class MicroCommandResult(val result: MicroResult, val json: bool)

fun microRun(): MicroCommandResult {
    val app = microCli()
    val schema = app.parseProcess()
    if (schema.succeeded && (schema.kind == "help" || schema.kind == "version"))
        return MicroCommandResult(MicroResult(true, schema.message), schema.has("json"))
    if (!schema.succeeded)
        return MicroCommandResult(MicroResult(false, schema.message), schema.has("json"))
    val jsonOutput = schema.has("json")
    var apiValue = "https://micro.do"
    val configured = linuxEnvironment("MICRO_API")
    if (configured.found && configured.value != "") apiValue = configured.value
    if (schema.has("api")) apiValue = schema.value("api")
    val api = microParseApi(apiValue)
    if (!api.valid) return MicroCommandResult(MicroResult(false, api.message), jsonOutput)
    val result = if (schema.isCommand("new"))
        microNewProject(schema.argument(0))
    else if (schema.isCommand("pull"))
        microPullProject(api, schema.argument(0), schema.argument(1, schema.argument(0)))
    else if (schema.isCommand("gallery")) microGallery(api)
    else if (schema.isCommand("remix"))
        microRemix(api, schema.argument(0), schema.argument(1, schema.argument(0)))
    else if (schema.isCommand("build")) microBuildProject(path("."))
    else if (schema.isCommand("dev") && schema.has("port"))
        microDev(microParsePort(schema.value("port"), -1))
    else if (schema.isCommand("dev")) microDev()
    else if (schema.isCommand("signup"))
        microSignup(api, schema.value("email"), schema.has("password-stdin"))
    else if (schema.isCommand("login")) microLogin(api)
    else if (schema.isCommand("logout")) microLogout(api)
    else if (schema.isCommand("account status")) microAccountStatus(api, schema.has("wait"))
    else if (schema.isCommand("plans")) microPlans(api)
    else if (schema.isCommand("platform status")) microPlatformStatus(api)
    else if (schema.isCommand("usage")) microUsageStatus(api)
    else if (schema.isCommand("spending-cap set"))
        microSetSpendingCap(
            api, microNonNegativeInt(schema.value("monthly-cents"), -1, 1000000),
            microPositiveInt(schema.value("warning-percent"), -1, 100),
            !schema.has("soft")
        )
    else if (schema.isCommand("spending-cap delete"))
        microDeleteSpendingCap(api, schema.has("confirm"))
    else if (schema.isCommand("billing")) microBillingStatus(api)
    else if (schema.isCommand("billing checkout"))
        microBillingCheckout(api, schema.argument(0))
    else if (schema.isCommand("billing portal")) microBillingPortal(api)
    else if (schema.isCommand("deploy") && schema.has("github") &&
        (schema.has("preview") || schema.argument(0) != "" ||
         schema.has("accept-price-changes") || schema.has("accept-live-products")))
        MicroResult(false, "--github cannot be combined with a slug, --preview, or product acceptance flags.")
    else if (schema.isCommand("deploy") && schema.has("github"))
        microDeployGithub(api, schema.has("prebuilt"))
    else if (schema.isCommand("deploy") && schema.has("preview") &&
        (schema.argument(0) != "" || schema.has("prebuilt") ||
         schema.has("accept-price-changes") || schema.has("accept-live-products")))
        MicroResult(false, "--preview cannot be combined with a slug, --prebuilt, or product acceptance flags.")
    else if (schema.isCommand("deploy") && schema.has("preview"))
        microDeploySite(api, "", true)
    else if (schema.isCommand("deploy") && schema.has("prebuilt"))
        MicroResult(false, "--prebuilt requires --github.")
    else if (schema.isCommand("deploy"))
        microDeploySite(
            api, schema.argument(0), false,
            schema.has("accept-price-changes"), schema.has("accept-live-products")
        )
    else if (schema.isCommand("github link"))
        microGithubLink(
            api, schema.value("repository"), schema.value("environment"),
            schema.value("ref"), schema.value("slug")
        )
    else if (schema.isCommand("github bindings")) microGithubBindings(api)
    else if (schema.isCommand("github revoke"))
        microGithubRevoke(api, schema.argument(0))
    else if (schema.isCommand("projects")) microProjects(api)
    else if (schema.isCommand("project deletions")) microProjectDeletions(api)
    else if (schema.isCommand("project delete"))
        microDeleteProject(api, schema.value("confirm-slug"), schema.has("confirm"))
    else if (schema.isCommand("status")) microProjectStatus(api)
    else if (schema.isCommand("settings")) microProjectSettings(api)
    else if (schema.isCommand("settings visibility"))
        microSetProjectVisibility(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("members")) microProjectMembers(api)
    else if (schema.isCommand("members set"))
        microSetProjectMember(
            api, schema.argument(0), schema.argument(1), schema.has("can-promote")
        )
    else if (schema.isCommand("members remove"))
        microRemoveProjectMember(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("invitations")) microProjectInvitations(api)
    else if (schema.isCommand("invitations create"))
        microCreateProjectInvitation(
            api, schema.argument(0), schema.argument(1), schema.has("can-promote")
        )
    else if (schema.isCommand("invitations revoke"))
        microRevokeProjectInvitation(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("invitations accept"))
        microAcceptProjectInvitation(api, schema.has("token-stdin"))
    else if (schema.isCommand("domains")) microProjectDomains(api)
    else if (schema.isCommand("domains add"))
        microAddProjectDomain(api, schema.argument(0))
    else if (schema.isCommand("domains verify"))
        microVerifyProjectDomain(api, schema.argument(0))
    else if (schema.isCommand("domains remove"))
        microRemoveProjectDomain(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("private-grants")) microProjectPrivateGrants(api)
    else if (schema.isCommand("private-grants create"))
        microCreateProjectPrivateGrant(
            api, microPositiveInt(schema.value("expires-days"), -1, 365),
            schema.value("label")
        )
    else if (schema.isCommand("private-grants revoke"))
        microRevokeProjectPrivateGrant(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("schedules")) microProjectSchedules(api)
    else if (schema.isCommand("schedules set"))
        microSetProjectSchedule(
            api, schema.argument(0),
            microPositiveInt(schema.value("every-minutes"), -1, 10080),
            if (schema.has("payload-file")) schema.value("payload-file") else "",
            !schema.has("disabled")
        )
    else if (schema.isCommand("schedules run"))
        microRunProjectSchedule(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("schedules remove"))
        microRemoveProjectSchedule(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("emails")) microProjectEmails(api)
    else if (schema.isCommand("deployments")) microProjectDeployments(api)
    else if (schema.isCommand("logs")) microProjectLogs(api, schema.value("since"))
    else if (schema.isCommand("users")) microUsers(api)
    else if (schema.isCommand("users disable"))
        microDisableUser(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("users enable"))
        microEnableUser(api, schema.argument(0))
    else if (schema.isCommand("users revoke-sessions"))
        microRevokeUserSessions(api, schema.argument(0), schema.has("confirm"))
    else if (schema.isCommand("records")) microRecords(api)
    else if (schema.isCommand("records delete"))
        microDeleteRecord(
            api, schema.argument(0), schema.argument(1), schema.argument(2),
            schema.argument(3), microPositiveInt(schema.value("version"), -1),
            schema.has("confirm")
        )
    else if (schema.isCommand("backups")) microBackups(api)
    else if (schema.isCommand("backups create"))
        microCreateBackup(api, schema.has("confirm"))
    else if (schema.isCommand("backups restore"))
        microRestoreBackup(
            api, schema.argument(0), schema.value("backup-sha256"),
            schema.value("expected-current-sha256"), schema.has("confirm")
        )
    else if (schema.isCommand("backups delete"))
        microDeleteBackup(
            api, schema.argument(0), schema.value("sha256"), schema.has("confirm")
        )
    else if (schema.isCommand("purchases")) microPurchases(api)
    else if (schema.isCommand("audit")) microAudit(api)
    else if (schema.isCommand("export"))
        microExport(
            api, schema.argument(0),
            if (schema.has("limit")) microPositiveInt(schema.value("limit"), -1, 100) else 100,
            if (schema.has("offset")) microNonNegativeInt(schema.value("offset"), -1, 100000) else 0
        )
    else if (schema.isCommand("retention")) microRetention(api)
    else if (schema.isCommand("retention set"))
        microSetRetention(
            api, microNonNegativeInt(schema.value("record-days"), -1, 3650),
            schema.has("automatic"), schema.has("confirm")
        )
    else if (schema.isCommand("retention prune"))
        microPruneRetention(
            api, microNonNegativeInt(schema.value("expected-records"), -1, 10000),
            schema.has("confirm")
        )
    else if (schema.isCommand("rollback"))
        microProjectRollback(api, schema.argument(0))
    else if (schema.isCommand("products")) microProducts(api)
    else if (schema.isCommand("products sync"))
        microSyncProducts(
            api, schema.has("accept-price-changes"), schema.has("accept-live-products")
        )
    else if (schema.isCommand("files")) microFiles(api)
    else if (schema.isCommand("files upload") &&
        schema.has("entitlement") && schema.has("public"))
        MicroResult(false, "--entitlement and --public are mutually exclusive.")
    else if (schema.isCommand("files upload") && schema.has("entitlement"))
        microUploadFile(
            api, schema.argument(0), schema.argument(1),
            "entitlement", schema.value("entitlement")
        )
    else if (schema.isCommand("files upload") && schema.has("public"))
        microUploadFile(api, schema.argument(0), schema.argument(1), "public")
    else if (schema.isCommand("files upload"))
        microUploadFile(api, schema.argument(0), schema.argument(1))
    else if (schema.isCommand("open")) microOpenProject()
    else if (schema.path.size > 0 && app.command(schema.path).commands.size > 0)
        MicroResult(true, app.help(schema.path))
    else MicroResult(false, "Invalid command.\n${microUsage()}")
    MicroCommandResult(result, jsonOutput)
}

fun main: int {
    val command = microRun()
    val result = command.result
    val output = if (command.json && result.structured != "") result.structured
        else if (command.json) jsonStringify(jsonObject(
            ["ok", "message"], [jsonBoolean(result.succeeded), jsonString(result.message)]
        ))
        else result.message
    if (result.succeeded) {
        linuxWriteStandardOutputAll("$output\n")
        0
    } else {
        if (command.json) linuxWriteStandardOutputAll("$output\n")
        else linuxWriteStandardErrorAll("micro: ${result.message}\n")
        1
    }
}
