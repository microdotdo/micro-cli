fun microProjectSchedules(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/schedules")

fun microProjectEmails(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/emails")

fun microSetProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    everyMinutes: int,
    payloadFile: string = "",
    enabled: bool = true
): MicroResult {
    if (!microScheduleIdValid(scheduleId) || !microScheduleIntervalValid(everyMinutes))
        return MicroResult(false, "Use a valid schedule ID and a 5 through 10080 minute interval.")
    var payloadText = "{}"
    if (payloadFile != "") {
        val source = path(payloadFile)
        val info = source.info()
        if (!info.isFile() || info.size < 2 || info.size > 8192)
            return MicroResult(false, "Schedule payload file must be regular JSON from 2 bytes through 8 KiB.")
        payloadText = source.readText()
    }
    if (!microSchedulePayloadValid(payloadText))
        return MicroResult(false, "Schedule payload must be a JSON object up to 8 KiB; never use it for credentials.")
    val payload = jsonParse(payloadText).value
    microLinkedOperation(
        api, "PUT", "/schedules",
        jsonStringify(jsonObject(
            ["id", "every_minutes", "payload", "enabled"],
            [jsonString(scheduleId), jsonInteger(everyMinutes), payload,
             jsonBoolean(enabled)]
        ))
    )
}

fun microRunProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Running a project schedule requires --confirm.")
    if (!microScheduleIdValid(scheduleId)) return MicroResult(false, "Schedule ID is invalid.")
    microLinkedOperation(api, "POST", "/schedules/$scheduleId/run", "{}")
}

fun microRemoveProjectSchedule(
    api: MicroApi,
    scheduleId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing a project schedule requires --confirm.")
    if (!microScheduleIdValid(scheduleId)) return MicroResult(false, "Schedule ID is invalid.")
    microLinkedOperation(
        api, "DELETE", "/schedules/$scheduleId", "", "Removed the project schedule."
    )
}

fun microDurationSeconds(value: string): int {
    if (value.size < 2) return 0
    val unit = value[value.size - 1]
    val number = microParsePort(value.slice(0, value.size - 1), 0)
    if (unit == 109) number * 60
    else if (unit == 104) number * 3600
    else if (unit == 100) number * 86400
    else 0
}

fun microProjectStatus(api: MicroApi): MicroResult = microLinkedRequest(api, "")

fun microProjectDeployments(api: MicroApi): MicroResult =
    microLinkedRequest(api, "/deployments")

fun microProjectLogs(api: MicroApi, since: string): MicroResult {
    val seconds = microDurationSeconds(since)
    if (seconds < 60 || seconds > 604800)
        return MicroResult(false, "--since must be 1m through 7d.")
    microLinkedRequest(api, "/logs?since_seconds=$seconds")
}

fun microProjectRollback(api: MicroApi, deployment: string): MicroResult {
    if (deployment.size != 36)
        return MicroResult(false, "Deployment ID must be a UUID.")
    val activated = microLinkedRequest(
        api,
        "/deployments/$deployment/activate",
        "POST"
    )
    if (!activated.succeeded) return activated
    val parsed = jsonParse(activated.structured)
    if (parsed.succeeded && parsed.value.isObject()) {
        val current = microLocalProject()
        if (current.valid) {
            val updated = jsonStringify(jsonObject(
                ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
                [jsonString(current.projectId), jsonString(current.slug), jsonString(deployment),
                 jsonString(parsed.value.getString("bundle_sha256")),
                 jsonString(parsed.value.getString("source_sha256"))]
            ))
            if (!path(".micro/project.json").writeTextAtomic(updated))
                return MicroResult(false, "Rollback succeeded remotely, but local state could not be updated.", activated.structured)
        }
    }
    activated
}

fun microOpenProject(): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val url = "https://${project.slug}.micro.do"
    if (linuxCommand("xdg-open").argument(url).run() == 0)
        MicroResult(true, "Opened $url", jsonStringify(jsonObject(
            ["ok", "url"], [jsonBoolean(true), jsonString(url)]
        )))
    else MicroResult(false, "Could not open $url.")
}

class MicroCommandResult(val result: MicroResult, val json: bool)

fun microRun(): MicroCommandResult {
    var count = linuxArgumentCount()
    val jsonOutput = count > 0 && linuxArgument(count - 1) == "--json"
    if (jsonOutput) count = count - 1
    var apiValue = "https://micro.do"
    val configured = linuxEnvironment("MICRO_API")
    if (configured.found && configured.value != "") apiValue = configured.value
    var index = 0
    if (index < count && linuxArgument(index) == "--api") {
        if (index + 1 >= count) return MicroCommandResult(MicroResult(false, "--api requires a URL.\n${microUsage()}"), jsonOutput)
        apiValue = linuxArgument(index + 1)
        index = index + 2
    }
    if (index >= count || linuxArgument(index) == "--help" || linuxArgument(index) == "-h")
        return MicroCommandResult(MicroResult(true, microUsage()), jsonOutput)
    if (linuxArgument(index) == "--version" || linuxArgument(index) == "-V")
        return MicroCommandResult(MicroResult(true, "micro 0.7.4"), jsonOutput)
    val api = microParseApi(apiValue)
    if (!api.valid) return MicroCommandResult(MicroResult(false, api.message), jsonOutput)
    val command = linuxArgument(index)
    val result = if (command == "new" && index + 2 == count)
        microNewProject(linuxArgument(index + 1))
    else if (command == "pull" && index + 2 == count)
        microPullProject(api, linuxArgument(index + 1), linuxArgument(index + 1))
    else if (command == "pull" && index + 3 == count)
        microPullProject(api, linuxArgument(index + 1), linuxArgument(index + 2))
    else if (command == "gallery" && index + 1 == count)
        microGallery(api)
    else if (command == "remix" && index + 2 == count)
        microRemix(api, linuxArgument(index + 1), linuxArgument(index + 1))
    else if (command == "remix" && index + 3 == count)
        microRemix(api, linuxArgument(index + 1), linuxArgument(index + 2))
    else if (command == "build" && index + 1 == count)
        microBuildProject(path("."))
    else if (command == "dev" && index + 1 == count)
        microDev()
    else if (command == "dev" && index + 3 == count &&
        linuxArgument(index + 1) == "--port")
        microDev(microParsePort(linuxArgument(index + 2), -1))
    else if (command == "signup" && index + 3 == count &&
        linuxArgument(index + 1) == "--email")
        microSignup(api, linuxArgument(index + 2), false)
    else if (command == "signup" && index + 4 == count &&
        linuxArgument(index + 1) == "--email" &&
        linuxArgument(index + 3) == "--password-stdin")
        microSignup(api, linuxArgument(index + 2), true)
    else if (command == "account" && index + 2 == count &&
        linuxArgument(index + 1) == "status")
        microAccountStatus(api)
    else if (command == "account" && index + 3 == count &&
        linuxArgument(index + 1) == "status" &&
        linuxArgument(index + 2) == "--wait")
        microAccountStatus(api, true)
    else if (command == "plans" && index + 1 == count) microPlans(api)
    else if (command == "platform" && index + 2 == count &&
        linuxArgument(index + 1) == "status") microPlatformStatus(api)
    else if (command == "usage" && index + 1 == count) microUsageStatus(api)
    else if (command == "spending-cap" && index + 6 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--monthly-cents" &&
        linuxArgument(index + 4) == "--warning-percent")
        microSetSpendingCap(
            api, microNonNegativeInt(linuxArgument(index + 3), -1, 1000000),
            microPositiveInt(linuxArgument(index + 5), -1, 100), true
        )
    else if (command == "spending-cap" && index + 7 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 2) == "--monthly-cents" &&
        linuxArgument(index + 4) == "--warning-percent" &&
        linuxArgument(index + 6) == "--soft")
        microSetSpendingCap(
            api, microNonNegativeInt(linuxArgument(index + 3), -1, 1000000),
            microPositiveInt(linuxArgument(index + 5), -1, 100), false
        )
    else if (command == "spending-cap" && index + 3 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 2) == "--confirm") microDeleteSpendingCap(api, true)
    else if (command == "spending-cap" && index + 2 == count &&
        linuxArgument(index + 1) == "delete") microDeleteSpendingCap(api, false)
    else if (command == "billing" && index + 1 == count) microBillingStatus(api)
    else if (command == "billing" && index + 3 == count &&
        linuxArgument(index + 1) == "checkout")
        microBillingCheckout(api, linuxArgument(index + 2))
    else if (command == "billing" && index + 2 == count &&
        linuxArgument(index + 1) == "portal") microBillingPortal(api)
    else if (command == "login" && index + 1 == count) microLogin(api)
    else if (command == "logout" && index + 1 == count) microLogout(api)
    else if (command == "projects" && index + 1 == count) microProjects(api)
    else if (command == "project" && index + 2 == count &&
        linuxArgument(index + 1) == "deletions") microProjectDeletions(api)
    else if (command == "project" && index + 5 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 2) == "--confirm-slug" &&
        linuxArgument(index + 4) == "--confirm")
        microDeleteProject(api, linuxArgument(index + 3), true)
    else if (command == "project" && index + 4 == count &&
        linuxArgument(index + 1) == "delete" &&
        linuxArgument(index + 2) == "--confirm-slug")
        microDeleteProject(api, linuxArgument(index + 3), false)
    else if (command == "deploy" && index + 2 == count &&
        linuxArgument(index + 1) == "--preview")
        microDeploySite(api, "", true)
    else if (command == "deploy" && index + 2 == count &&
        linuxArgument(index + 1) == "--github")
        microDeployGithub(api)
    else if (command == "deploy" && index + 2 == count)
        microDeploySite(api, linuxArgument(index + 1), false)
    else if (command == "deploy" && index + 3 == count &&
        linuxArgument(index + 2) == "--accept-price-changes")
        microDeploySite(api, linuxArgument(index + 1), false, true)
    else if (command == "deploy" && index + 3 == count &&
        linuxArgument(index + 2) == "--accept-live-products")
        microDeploySite(api, linuxArgument(index + 1), false, false, true)
    else if (command == "deploy" && index + 4 == count &&
        linuxArgument(index + 2) == "--accept-price-changes" &&
        linuxArgument(index + 3) == "--accept-live-products")
        microDeploySite(api, linuxArgument(index + 1), false, true, true)
    else if (command == "status" && index + 1 == count) microProjectStatus(api)
    else if (command == "settings" && index + 1 == count) microProjectSettings(api)
    else if (command == "settings" && index + 4 == count &&
        linuxArgument(index + 1) == "visibility" &&
        linuxArgument(index + 3) == "--confirm")
        microSetProjectVisibility(api, linuxArgument(index + 2), true)
    else if (command == "settings" && index + 3 == count &&
        linuxArgument(index + 1) == "visibility")
        microSetProjectVisibility(api, linuxArgument(index + 2), false)
    else if (command == "members" && index + 1 == count) microProjectMembers(api)
    else if (command == "members" && index + 4 == count &&
        linuxArgument(index + 1) == "set")
        microSetProjectMember(
            api, linuxArgument(index + 2), linuxArgument(index + 3), false
        )
    else if (command == "members" && index + 5 == count &&
        linuxArgument(index + 1) == "set" &&
        linuxArgument(index + 4) == "--can-promote")
        microSetProjectMember(
            api, linuxArgument(index + 2), linuxArgument(index + 3), true
        )
    else if (command == "members" && index + 4 == count &&
        linuxArgument(index + 1) == "remove" &&
        linuxArgument(index + 3) == "--confirm")
        microRemoveProjectMember(api, linuxArgument(index + 2), true)
    else if (command == "members" && index + 3 == count &&
        linuxArgument(index + 1) == "remove")
        microRemoveProjectMember(api, linuxArgument(index + 2), false)
    else if (command == "invitations" && index + 1 == count)
        microProjectInvitations(api)
    else if (command == "invitations" && index + 4 == count &&
        linuxArgument(index + 1) == "create")
        microCreateProjectInvitation(
            api, linuxArgument(index + 2), linuxArgument(index + 3), false
        )
    else if (command == "invitations" && index + 5 == count &&
        linuxArgument(index + 1) == "create" &&
        linuxArgument(index + 4) == "--can-promote")
        microCreateProjectInvitation(
            api, linuxArgument(index + 2), linuxArgument(index + 3), true
        )
    else if (command == "invitations" && index + 4 == count &&
        linuxArgument(index + 1) == "revoke" &&
        linuxArgument(index + 3) == "--confirm")
        microRevokeProjectInvitation(api, linuxArgument(index + 2), true)
    else if (command == "invitations" && index + 3 == count &&
        linuxArgument(index + 1) == "revoke")
        microRevokeProjectInvitation(api, linuxArgument(index + 2), false)
    else if (command == "invitations" && index + 3 == count &&
        linuxArgument(index + 1) == "accept" &&
        linuxArgument(index + 2) == "--token-stdin")
        microAcceptProjectInvitation(api, true)
    else if (command == "domains" && index + 1 == count) microProjectDomains(api)
    else if (command == "domains" && index + 3 == count &&
        linuxArgument(index + 1) == "add")
        microAddProjectDomain(api, linuxArgument(index + 2))
    else if (command == "domains" && index + 3 == count &&
        linuxArgument(index + 1) == "verify")
        microVerifyProjectDomain(api, linuxArgument(index + 2))
    else if (command == "domains" && index + 4 == count &&
        linuxArgument(index + 1) == "remove" &&
        linuxArgument(index + 3) == "--confirm")
        microRemoveProjectDomain(api, linuxArgument(index + 2), true)
    else if (command == "domains" && index + 3 == count &&
        linuxArgument(index + 1) == "remove")
        microRemoveProjectDomain(api, linuxArgument(index + 2), false)
    else if (command == "private-grants" && index + 1 == count)
        microProjectPrivateGrants(api)
    else if (command == "private-grants" && index + 6 == count &&
        linuxArgument(index + 1) == "create" &&
        linuxArgument(index + 2) == "--expires-days" &&
        linuxArgument(index + 4) == "--label")
        microCreateProjectPrivateGrant(
            api, microPositiveInt(linuxArgument(index + 3), -1, 365),
