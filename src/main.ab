fun microDeleteProject(
    api: MicroApi,
    confirmedSlug: string,
    confirmed: bool
): MicroResult {
    if (!confirmed)
        return MicroResult(false, "Project deletion requires --confirm and the exact linked slug with --confirm-slug.")
    val project = microLocalProject()
    if (!project.valid || !microUuidValid(project.projectId))
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!microProjectDeletionConfirmationValid(
        project.projectId, project.slug, confirmedSlug, confirmed
    )) return MicroResult(
        false,
        "--confirm-slug must exactly match the linked slug '${project.slug}'; nothing was deleted."
    )
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "DELETE", "/api/v1/projects/${project.slug}",
        jsonStringify(jsonObject(
            ["project_id", "slug"],
            [jsonString(project.projectId), jsonString(project.slug)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Project-Delete", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !microUuidValid(parsed.value.getString("id")))
        return MicroResult(false, "micro.do returned an invalid project-deletion receipt.")
    val receiptId = parsed.value.getString("id")
    val status = parsed.value.getString("status")
    MicroResult(
        true,
        "Project ${project.slug} is hidden and deletion receipt $receiptId is $status. The remote slug is reserved for 30 days; local source was not removed.",
        response.response.body
    )
}

class MicroLocalProject(
    val valid: bool,
    val projectId: string,
    val slug: string,
    val deploymentId: string
)

fun microRestoreBundleFiles(root: Path, files: Json, publicFiles: bool): string {
    if (!files.isArray()) return "The source snapshot has an invalid file list."
    var index = 0
    var error = ""
    while (index < files.size() && error == "") {
        val file = files.at(index)
        val relative = file.getString("path")
        val encoded = file.getString("body_base64")
        val expected = file.getString("sha256")
        if (!file.isObject() || !microPathSafe(relative) || expected.size != 64) {
            error = "The source snapshot contains an unsafe file path."
        } else {
            val contents = base64Decode(encoded)
            if (microDigest(contents) != expected) {
                error = "The source snapshot failed its checksum: $relative"
            } else {
                val target = if (publicFiles) root.child("public").child(relative)
                    else root.child(relative)
                if (!target.createParentDirectories() || !target.writeTextAtomic(contents))
                    error = "Could not restore $relative."
            }
        }
        index = index + 1
    }
    error
}

fun microPullProject(api: MicroApi, slug: string, directory: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    if (directory == "" || directory == "/" || directory == "." || directory == "..")
        return MicroResult(false, "Choose a dedicated pull directory.")
    val root = path(directory)
    if (root.exists() && (!root.info().isDirectory() || root.entries().size > 0))
        return MicroResult(false, "$directory already exists and is not empty.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/projects/$slug/source", "", "application/json",
        credentials.accessToken, 67108864
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid source snapshot.")
    val bundle = parsed.value.get("bundle")
    if (!bundle.isObject()) return MicroResult(false, "micro.do omitted the source bundle.")
    if (!root.createDirectories()) return MicroResult(false, "Could not create $directory.")
    var error = microRestoreBundleFiles(root, bundle.get("source"), false)
    if (error == "") error = microRestoreBundleFiles(root, bundle.get("assets"), true)
    if (error != "") return MicroResult(false, error)
    val state = jsonStringify(jsonObject(
        ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
        [jsonString(parsed.value.getString("project_id")), jsonString(slug),
         jsonString(parsed.value.getString("deployment_id")),
         jsonString(parsed.value.getString("bundle_sha256")),
         jsonString(parsed.value.getString("source_sha256"))]
    ))
    if (!root.child(".micro/project.json").writeTextAtomic(state))
        return MicroResult(false, "Source was restored, but local project state could not be saved.")
    MicroResult(
        true,
        "Pulled $slug into $directory",
        jsonStringify(jsonObject(
            ["ok", "slug", "directory", "project_id", "deployment_id", "source_sha256"],
            [jsonBoolean(true), jsonString(slug), jsonString(directory),
             jsonString(parsed.value.getString("project_id")),
             jsonString(parsed.value.getString("deployment_id")),
             jsonString(parsed.value.getString("source_sha256"))]
        ))
    )
}

fun microGallery(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/gallery", "", "application/json", "", 1048576)
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.gallery.v1" ||
        !parsed.value.get("entries").isArray())
        return MicroResult(false, "micro.do returned an invalid gallery.")
    val entries = parsed.value.get("entries")
    var message = if (entries.size() == 0) "No curated Micros are published yet." else "Curated Micros:"
    var index = 0
    while (index < entries.size()) {
        val entry = entries.at(index)
        val id = entry.getString("id")
        val title = entry.getString("title")
        val license = entry.getString("license")
        if (!entry.isObject() || !microGalleryEntryIdValid(id) || title == "" || license == "")
            return MicroResult(false, "micro.do returned an invalid gallery entry.")
        message = "$message\n  $id · $title · $license"
        index = index + 1
    }
    MicroResult(true, message, response.response.body)
}

fun microRemix(api: MicroApi, entryId: string, directory: string): MicroResult {
    if (!microGalleryEntryIdValid(entryId))
        return MicroResult(false, "Gallery entry must be 3-64 lowercase letters, digits, or hyphens.")
    if (directory == "" || directory == "/" || directory == "." || directory == ".." ||
        !microPathSafe(directory))
        return MicroResult(false, "Choose a safe dedicated remix directory.")
    val root = path(directory)
    if (root.exists() && (!root.info().isDirectory() || root.entries().size > 0))
        return MicroResult(false, "$directory already exists and is not empty.")
    val response = microRequest(
        api, "GET", "/api/v1/gallery/$entryId", "", "application/json", "", 67108864
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.gallery-source.v1")
        return MicroResult(false, "micro.do returned an invalid curated source snapshot.")
    val entry = parsed.value.get("entry")
    val bundle = parsed.value.get("bundle")
    val copyPolicy = entry.get("copy_policy")
    val sourceDeployment = entry.getString("source_deployment")
    val bundleSha = entry.getString("bundle_sha256")
    val sourceSha = entry.getString("source_sha256")
    val consentRecorded = entry.get("consent_recorded")
    if (!entry.isObject() || entry.getString("id") != entryId ||
        !microUuidValid(sourceDeployment) || !microSha256Valid(bundleSha) ||
        !microSha256Valid(sourceSha) ||
        entry.getString("terms_version") != "micro.gallery.v1" ||
        !consentRecorded.isBoolean() || !consentRecorded.asBoolean() ||
        !bundle.isObject() ||
        !copyPolicy.isObject() ||
        copyPolicy.getString("version") != "micro.gallery-copy.v1")
        return MicroResult(false, "micro.do returned incomplete remix provenance.")
    if (!root.createDirectories()) return MicroResult(false, "Could not create $directory.")
    var error = microRestoreBundleFiles(root, bundle.get("source"), false)
    if (error == "") error = microRestoreBundleFiles(root, bundle.get("assets"), true)
    if (error != "") return MicroResult(false, error)
    if (!microRemoveRemixSlug(root))
        return MicroResult(false, "Source was restored, but its source slug could not be removed.")
    val provenance = jsonStringify(jsonObject(
        ["schema", "entry", "title", "creator", "license", "source_project",
         "source_deployment", "bundle_sha256", "source_sha256", "terms_version",
         "consent_recorded", "curated_at", "copy_policy"],
        [jsonString("micro.remix.v1"), jsonString(entryId),
         jsonString(entry.getString("title")), jsonString(entry.getString("creator")),
         jsonString(entry.getString("license")),
         jsonString(entry.getString("source_project")),
         jsonString(sourceDeployment), jsonString(bundleSha), jsonString(sourceSha),
         jsonString(entry.getString("terms_version")), jsonBoolean(true),
         jsonString(entry.getString("curated_at")), copyPolicy]
    ))
    if (!root.child(".micro").createDirectories() ||
        !root.child(".micro/remix.json").writeTextAtomic(provenance))
        return MicroResult(false, "Source was restored, but remix provenance could not be saved.")
    MicroResult(
        true,
        "Remixed ${entry.getString("title")} into $directory. No project or slug was created; review it and run `micro dev`.",
        jsonStringify(jsonObject(
            ["ok", "entry", "directory", "source_sha256", "project_created", "slug_reserved"],
            [jsonBoolean(true), jsonString(entryId), jsonString(directory),
             jsonString(sourceSha), jsonBoolean(false), jsonBoolean(false)]
        ))
    )
}

fun microLocalProject(): MicroLocalProject {
    val parsed = jsonParse(path(".micro/project.json").readText())
    if (parsed.succeeded && parsed.value.isObject()) {
        val projectId = parsed.value.getString("project_id")
        val slug = parsed.value.getString("slug")
        MicroLocalProject(
            projectId != "" && microSlugValid(slug),
            projectId,
            slug,
            parsed.value.getString("deployment_id")
        )
    } else MicroLocalProject(false, "", "", "")
}

fun microLinkedRequest(
    api: MicroApi,
    endpoint: string,
    method: string = "GET"
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api,
        method,
        "/api/v1/projects/${project.slug}$endpoint",
        "",
        "application/json",
        credentials.accessToken
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microAuthenticatedRequest(
    api: MicroApi,
    method: string,
    endpoint: string,
    body: string = "",
    successMessage: string = ""
): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, method, endpoint, body, "application/json", credentials.accessToken
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val message = if (response.response.body != "") response.response.body else successMessage
    MicroResult(true, message, response.response.body)
}

fun microLinkedOperation(
    api: MicroApi,
    method: string,
    endpoint: string,
    body: string = "",
    successMessage: string = ""
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    microAuthenticatedRequest(
        api, method, "/api/v1/projects/${project.slug}$endpoint", body, successMessage
    )
}

fun microProjectRoleValid(role: string): bool =
    role == "viewer" || role == "developer" || role == "admin"

fun microPlans(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/plans")
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microPlatformStatus(api: MicroApi): MicroResult {
    val response = microRequest(api, "GET", "/api/v1/status")
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    val status = if (parsed.succeeded) parsed.value.getString("status") else ""
    if (!parsed.succeeded || !parsed.value.isObject() ||
        parsed.value.getString("schema") != "micro.status.v1" ||
        (status != "operational" && status != "degraded" && status != "major_outage") ||
        !parsed.value.get("components").isArray() ||
        !parsed.value.get("incidents").isArray())
        return MicroResult(false, "micro.do returned an invalid platform-status response.")
    MicroResult(true, response.response.body, response.response.body)
}

fun microUsageStatus(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "GET", "/api/v1/usage")

fun microSetSpendingCap(
    api: MicroApi,
    monthlyCents: int,
    warningPercent: int,
    hardStop: bool
): MicroResult {
    if (monthlyCents < 0 || monthlyCents > 1000000 ||
        warningPercent < 1 || warningPercent > 100)
        return MicroResult(false, "Monthly cents must be 0 through 1000000 and warning percent 1 through 100.")
    microAuthenticatedRequest(
        api, "PUT", "/api/v1/spending-cap",
        jsonStringify(jsonObject(
            ["monthly_usage_cap_cents", "warning_percent", "hard_stop"],
            [jsonInteger(monthlyCents), jsonInteger(warningPercent), jsonBoolean(hardStop)]
        ))
    )
}

fun microDeleteSpendingCap(api: MicroApi, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing the spending cap requires --confirm.")
    microAuthenticatedRequest(
        api, "DELETE", "/api/v1/spending-cap", "", "Removed the account spending cap."
    )
}

fun microBillingStatus(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "GET", "/api/v1/billing")

fun microBillingCheckout(api: MicroApi, planId: string): MicroResult {
    if (!microProductIdValid(planId)) return MicroResult(false, "Plan ID is invalid.")
    microAuthenticatedRequest(
        api, "POST", "/api/v1/billing/checkout",
        jsonStringify(jsonObject(["plan_id"], [jsonString(planId)]))
    )
}

fun microBillingPortal(api: MicroApi): MicroResult =
    microAuthenticatedRequest(api, "POST", "/api/v1/billing/portal", "{}")

fun microProjectSettings(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/settings")

fun microSetProjectVisibility(
    api: MicroApi,
    visibility: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Changing project visibility requires --confirm.")
    if (visibility != "public" && visibility != "private")
        return MicroResult(false, "Visibility must be public or private.")
    microLinkedOperation(
        api, "PUT", "/settings",
        jsonStringify(jsonObject(["visibility"], [jsonString(visibility)]))
    )
}

fun microProjectMembers(api: MicroApi): MicroResult =
    microLinkedOperation(api, "GET", "/members")

fun microSetProjectMember(
    api: MicroApi,
    email: string,
    role: string,
    canPromote: bool
): MicroResult {
    if (!microProjectRoleValid(role) || (role == "viewer" && canPromote))
        return MicroResult(false, "Role must be viewer, developer, or admin; viewers cannot promote.")
    microLinkedOperation(
        api, "PUT", "/members",
        jsonStringify(jsonObject(
            ["email", "role", "can_promote"],
            [jsonString(email), jsonString(role), jsonBoolean(canPromote)]
        ))
    )
}

fun microRemoveProjectMember(api: MicroApi, accountId: string, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Removing a project member requires --confirm.")
    if (!microUuidValid(accountId)) return MicroResult(false, "Project member ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/members/$accountId", "", "Removed the project member."
    )
}

fun microProjectInvitations(api: MicroApi): MicroResult =
