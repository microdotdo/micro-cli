import "project.ab"
import "abla/process/time"

fun microUsage(): string = "micro 0.7.4\n\nBuild, deploy, and operate small full-stack sites on micro.do\n\nUsage:\n  micro [--api URL] new <directory> [--json]\n  micro [--api URL] pull <slug> [directory] [--json]\n  micro [--api URL] gallery [--json]\n  micro [--api URL] remix <entry> [directory] [--json]\n  micro [--api URL] build [--json]\n  micro [--api URL] dev [--port PORT] [--json]\n  micro [--api URL] signup --email <email> [--password-stdin] [--json]\n  micro [--api URL] login\n  micro [--api URL] logout [--json]\n  micro [--api URL] account status [--wait] [--json]\n  micro [--api URL] plans [--json]\n  micro [--api URL] platform status [--json]\n  micro [--api URL] usage [--json]\n  micro [--api URL] spending-cap set --monthly-cents CENTS --warning-percent PERCENT [--soft] [--json]\n  micro [--api URL] spending-cap delete --confirm [--json]\n  micro [--api URL] billing [--json]\n  micro [--api URL] billing checkout <plan> [--json]\n  micro [--api URL] billing portal [--json]\n  micro [--api URL] deploy --preview [--json]\n  micro [--api URL] deploy --github [--json]\n  micro [--api URL] deploy <slug> [--accept-price-changes] [--accept-live-products] [--json]\n  micro [--api URL] github link --repository OWNER/REPO --environment NAME --ref REF --slug SLUG [--json]\n  micro [--api URL] github bindings [--json]\n  micro [--api URL] github revoke <binding-id> [--json]\n  micro [--api URL] projects [--json]\n  micro [--api URL] project deletions [--json]\n  micro [--api URL] project delete --confirm-slug SLUG --confirm [--json]\n  micro [--api URL] status [--json]\n  micro [--api URL] settings [--json]\n  micro [--api URL] settings visibility <public|private> --confirm [--json]\n  micro [--api URL] members [--json]\n  micro [--api URL] members set <email> <viewer|developer|admin> [--can-promote] [--json]\n  micro [--api URL] members remove <account-id> --confirm [--json]\n  micro [--api URL] invitations [--json]\n  micro [--api URL] invitations create <email> <viewer|developer|admin> [--can-promote] [--json]\n  micro [--api URL] invitations revoke <invitation-id> --confirm [--json]\n  micro [--api URL] invitations accept --token-stdin [--json]\n  micro [--api URL] domains [--json]\n  micro [--api URL] domains add <hostname> [--json]\n  micro [--api URL] domains verify <domain-id> [--json]\n  micro [--api URL] domains remove <domain-id> --confirm [--json]\n  micro [--api URL] private-grants [--json]\n  micro [--api URL] private-grants create --expires-days DAYS --label LABEL [--json]\n  micro [--api URL] private-grants revoke <grant-id> --confirm [--json]\n  micro [--api URL] schedules [--json]\n  micro [--api URL] schedules set <id> --every-minutes MINUTES [--payload-file FILE] [--disabled] [--json]\n  micro [--api URL] schedules run <id> --confirm [--json]\n  micro [--api URL] schedules remove <id> --confirm [--json]\n  micro [--api URL] emails [--json]\n  micro [--api URL] deployments [--json]\n  micro [--api URL] logs [--since 30m] [--json]\n  micro [--api URL] users [--json]\n  micro [--api URL] users disable <user-id> --confirm [--json]\n  micro [--api URL] users enable <user-id> [--json]\n  micro [--api URL] users revoke-sessions <user-id> --confirm [--json]\n  micro [--api URL] records [--json]\n  micro [--api URL] records delete <environment> <collection> <scope> <key> --version <version> --confirm [--json]\n  micro [--api URL] backups [--json]\n  micro [--api URL] backups create --confirm [--json]\n  micro [--api URL] backups restore <backup-id> --backup-sha256 SHA --expected-current-sha256 SHA --confirm [--json]\n  micro [--api URL] backups delete <backup-id> --sha256 SHA --confirm [--json]\n  micro [--api URL] purchases [--json]\n  micro [--api URL] audit [--json]\n  micro [--api URL] export [<resource> [--limit 100 --offset 0]] [--json]\n  micro [--api URL] retention [--json]\n  micro [--api URL] retention set --record-days DAYS [--automatic] --confirm [--json]\n  micro [--api URL] retention prune --expected-records COUNT --confirm [--json]\n  micro [--api URL] rollback <deployment> [--json]\n  micro [--api URL] products [sync [--accept-price-changes] [--accept-live-products]] [--json]\n  micro [--api URL] files [--json]\n  micro [--api URL] files upload <id> <path> [--entitlement <id>|--public] [--json]\n  micro [--api URL] open\n"

fun microRunner(): string {
    val configured = linuxEnvironment("MICRO_RUNNER")
    if (configured.found && configured.value != "") configured.value else "micro-runner"
}

fun microDev(port: int = 8787): MicroResult {
    if (port <= 0 || port > 65535)
        return MicroResult(false, "Development port must be between 1 and 65535.")
    val built = microBuildProject(path("."))
    if (!built.succeeded) return built
    val bundle = "${currentDirectory().text}/.micro/bundle.json"
    val url = "http://127.0.0.1:$port"
    linuxWriteStandardOutputAll("Micro development runner: $url\n")
    val command = linuxCommand(microRunner())
    command.argument("dev")
    command.argument(bundle)
    command.argument("--bind")
    command.argument("127.0.0.1:$port")
    val status = command.run()
    if (status == 0 || status == 130) MicroResult(
        true,
        "Development runner stopped.",
        jsonStringify(jsonObject(
            ["ok", "url", "stopped"],
            [jsonBoolean(true), jsonString(url), jsonBoolean(true)]
        ))
    ) else MicroResult(false, "The development runner exited with status $status.")
}

fun microProducts(api: MicroApi): MicroResult = microLinkedRequest(api, "/products")

fun microSyncProducts(
    api: MicroApi,
    acceptPriceChanges: bool = false,
    acceptLiveProducts: bool = false
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!path("micro.yaml").exists())
        return MicroResult(false, "This project does not have micro.yaml.")
    val definitions = microProductDefinitions(path("."))
    if (!definitions.succeeded) return MicroResult(false, definitions.message)
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val syncHeaders: array<HttpHeader> = []
    if (acceptPriceChanges)
        syncHeaders.append(HttpHeader("X-Micro-Accept-Price-Changes", "true"))
    if (acceptLiveProducts)
        syncHeaders.append(HttpHeader("X-Micro-Accept-Live-Products", "true"))
    val response = microRequest(
        api,
        "PUT",
        "/api/v1/projects/${project.slug}/products",
        jsonStringify(jsonObject(["products"], [definitions.apiProducts])),
        "application/json",
        credentials.accessToken,
        1048576,
        syncHeaders
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microFiles(api: MicroApi): MicroResult = microLinkedRequest(api, "/files")

fun microUsers(api: MicroApi): MicroResult = microLinkedRequest(api, "/users?limit=100")

fun microManageUser(api: MicroApi, userId: string, operation: string): MicroResult {
    if (!microUuidValid(userId)) return MicroResult(false, "App user ID must be a UUID.")
    val changed = microLinkedRequest(api, "/users/$userId/$operation", "POST")
    if (!changed.succeeded) return changed
    val parsed = jsonParse(changed.structured)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid app-user response.")
    val email = parsed.value.getString("email")
    val sessions = parsed.value.getInt("sessions_revoked")
    val transfers = parsed.value.getInt("transfers_revoked")
    val message = if (operation == "disable")
        "Disabled $email; revoked $sessions sessions and $transfers private download grants."
    else if (operation == "enable") "Enabled $email."
    else "Revoked $sessions sessions and $transfers private download grants for $email."
    MicroResult(true, message, changed.structured)
}

fun microDisableUser(api: MicroApi, userId: string, confirmed: bool): MicroResult {
    if (!confirmed)
        return MicroResult(false, "Disabling an app user requires --confirm.")
    microManageUser(api, userId, "disable")
}

fun microEnableUser(api: MicroApi, userId: string): MicroResult =
    microManageUser(api, userId, "enable")

fun microRevokeUserSessions(api: MicroApi, userId: string, confirmed: bool): MicroResult {
    if (!confirmed)
        return MicroResult(false, "Revoking app-user sessions requires --confirm.")
    microManageUser(api, userId, "revoke-sessions")
}

fun microRecords(api: MicroApi): MicroResult = microLinkedRequest(api, "/records?limit=100")

fun microDeleteRecord(
    api: MicroApi,
    environment: string,
    collection: string,
    scope: string,
    key: string,
    version: int,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Exact record deletion requires --confirm.")
    if ((environment != "preview" && environment != "production") ||
        !microDataNameValid(collection, 48) || !microRecordScopeValid(scope) ||
        !microDataNameValid(key, 128) || version < 1)
        return MicroResult(false, "The exact record identity or version is invalid.")
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "DELETE", "/api/v1/projects/${project.slug}/records",
        jsonStringify(jsonObject(
            ["environment", "collection", "scope", "key", "version"],
            [jsonString(environment), jsonString(collection), jsonString(scope),
             jsonString(key), jsonInteger(version)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Delete", "true")]
    )
    if (response.succeeded) MicroResult(
        true,
        "Deleted $environment $collection/$key ($scope, v$version).",
        response.response.body
    ) else MicroResult(false, response.message)
}

fun microBackups(api: MicroApi): MicroResult = microLinkedRequest(api, "/backups")

fun microCreateBackup(api: MicroApi, confirmed: bool): MicroResult {
    if (!confirmed) return MicroResult(false, "Creating a record backup requires --confirm.")
    val project = microLocalProject()
    if (!project.valid || !microUuidValid(project.projectId))
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "POST", "/api/v1/projects/${project.slug}/backups",
        jsonStringify(jsonObject(
            ["project_id", "slug"],
            [jsonString(project.projectId), jsonString(project.slug)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Backup", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !microUuidValid(parsed.value.getString("backup_id")) ||
        !microSha256Valid(parsed.value.getString("sha256")))
        return MicroResult(false, "micro.do returned an invalid record-backup receipt.")
    MicroResult(
        true,
        "Created record backup ${parsed.value.getString("backup_id")} with ${parsed.value.getInt("record_count")} records (${parsed.value.getString("sha256")}).",
        response.response.body
    )
}

fun microRestoreBackup(
    api: MicroApi,
    backupId: string,
    backupSha256: string,
    expectedCurrentSha256: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Restoring a record backup requires --confirm.")
    if (!microUuidValid(backupId) || !microSha256Valid(backupSha256) ||
        !microSha256Valid(expectedCurrentSha256))
        return MicroResult(false, "Restore requires an exact backup UUID, backup SHA-256, and current-record SHA-256 from `micro backups`.")
    val project = microLocalProject()
    if (!project.valid || !microUuidValid(project.projectId))
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "POST", "/api/v1/projects/${project.slug}/backups/$backupId/restore",
        jsonStringify(jsonObject(
            ["project_id", "slug", "backup_id", "backup_sha256", "expected_current_sha256"],
            [jsonString(project.projectId), jsonString(project.slug), jsonString(backupId),
             jsonString(backupSha256), jsonString(expectedCurrentSha256)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Restore", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !parsed.value.get("restored").asBoolean() ||
        parsed.value.getString("backup_id") != backupId)
        return MicroResult(false, "micro.do returned an invalid record-restore receipt.")
    MicroResult(
        true,
        "Restored ${parsed.value.getInt("record_count")} records from $backupId; users, purchases, entitlements, products, files, and deployments were preserved.",
        response.response.body
    )
}

fun microDeleteBackup(
    api: MicroApi,
    backupId: string,
    sha256: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Deleting a record backup requires --confirm.")
    if (!microUuidValid(backupId) || !microSha256Valid(sha256))
        return MicroResult(false, "Backup deletion requires an exact backup UUID and SHA-256 from `micro backups`.")
    val project = microLocalProject()
    if (!project.valid || !microUuidValid(project.projectId))
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "DELETE", "/api/v1/projects/${project.slug}/backups/$backupId",
        jsonStringify(jsonObject(
            ["project_id", "slug", "backup_id", "sha256"],
            [jsonString(project.projectId), jsonString(project.slug),
             jsonString(backupId), jsonString(sha256)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Backup-Delete", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    MicroResult(
        true,
        "Deleted record backup $backupId. Current project data and local source were not changed.",
        response.response.body
    )
}

fun microPurchases(api: MicroApi): MicroResult = microLinkedRequest(api, "/purchases?limit=100")

fun microAudit(api: MicroApi): MicroResult = microLinkedRequest(api, "/audit?limit=100")

fun microExportResourceValid(value: string): bool =
    value == "users" || value == "records" || value == "purchases" ||
    value == "entitlements" || value == "products" || value == "files" ||
    value == "audit"

fun microExport(
    api: MicroApi,
    resourceName: string = "",
    limit: int = 100,
    offset: int = 0
): MicroResult {
    if (resourceName != "" && !microExportResourceValid(resourceName))
        return MicroResult(false, "Export resource must be users, records, purchases, entitlements, products, files, or audit.")
    if (limit < 1 || limit > 100 || offset < 0 || offset > 100000)
        return MicroResult(false, "Export pages require a limit from 1 through 100 and an offset from 0 through 100000.")
    val endpoint = if (resourceName == "") "/export"
        else "/export/$resourceName?limit=$limit&offset=$offset"
    microLinkedRequest(api, endpoint)
}

fun microRetention(api: MicroApi): MicroResult = microLinkedRequest(api, "/retention")

fun microSetRetention(
    api: MicroApi,
    recordDays: int,
    automatic: bool,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Changing retention requires --confirm.")
    if (!microRetentionPolicyValid(recordDays, automatic))
        return MicroResult(false, "Use 0 to keep records forever, or 30 through 3650 days; automatic pruning needs a finite policy.")
    val current = microRetention(api)
    if (!current.succeeded) return current
    val parsed = jsonParse(current.structured)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !parsed.value.get("version").intAvailable())
        return MicroResult(false, "micro.do returned an invalid retention policy.")
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "PUT", "/api/v1/projects/${project.slug}/retention",
        jsonStringify(jsonObject(
            ["record_days", "automatic", "expected_version"],
            [jsonInteger(recordDays), jsonBoolean(automatic),
             jsonInteger(parsed.value.getInt("version"))]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Retention", "true")]
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val mode = if (recordDays == 0) "keep records forever"
        else if (automatic) "automatically prune records older than $recordDays days"
        else "preview records older than $recordDays days for manual pruning"
    MicroResult(true, "Retention updated: $mode.", response.response.body)
}

fun microPruneRetention(
    api: MicroApi,
    expectedRecords: int,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Record pruning requires --confirm.")
    if (expectedRecords < 0)
        return MicroResult(false, "Expected record count must be a non-negative integer.")
    val current = microRetention(api)
    if (!current.succeeded) return current
    val parsed = jsonParse(current.structured)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !parsed.value.get("record_days").intAvailable() ||
        !parsed.value.get("version").intAvailable() ||
        !parsed.value.get("cutoff_epoch").intAvailable() ||
        !parsed.value.get("eligible_records").intAvailable())
        return MicroResult(false, "micro.do returned an invalid retention preview.")
    val recordDays = parsed.value.getInt("record_days")
    val eligible = parsed.value.getInt("eligible_records")
    if (recordDays < 30)
        return MicroResult(false, "Retention keeps records forever; set a finite policy before pruning.")
    if (eligible != expectedRecords)
        return MicroResult(false, "Retention preview has $eligible eligible records, not the expected $expectedRecords. Inspect `micro retention` again.")
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "POST", "/api/v1/projects/${project.slug}/retention/prune",
        jsonStringify(jsonObject(
            ["expected_version", "cutoff_epoch", "expected_records"],
            [jsonInteger(parsed.value.getInt("version")),
             jsonInteger(parsed.value.getInt("cutoff_epoch")), jsonInteger(expectedRecords)]
        )), "application/json", credentials.accessToken, 1048576,
        [HttpHeader("X-Micro-Confirm-Prune", "true")]
    )
    if (response.succeeded) MicroResult(
        true,
        "Pruned $expectedRecords project record${if (expectedRecords == 1) "" else "s"}; purchases and entitlements were preserved.",
        response.response.body
    ) else MicroResult(false, response.message)
}

fun microUploadFile(
    api: MicroApi,
    stableId: string,
    sourceName: string,
    access: string = "private",
    entitlement: string = ""
): MicroResult {
    val project = microLocalProject()
    if (!project.valid)
        return MicroResult(false, "This directory is not linked to a deployed Micro.")
    if (!microProductIdValid(stableId)) return MicroResult(false, "Protected file ID is invalid.")
    if (access == "entitlement" && !microProductIdValid(entitlement))
        return MicroResult(false, "Entitlement ID is invalid.")
    val source = path(sourceName)
    val info = source.info()
    if (!info.isFile() || info.size <= 0 || info.size > 33554432)
        return MicroResult(false, "Protected file must be a regular file from 1 byte through 32 MiB.")
    val contents = source.readText()
    if (contents.size != info.size)
        return MicroResult(false, "Protected file could not be read completely.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api,
        "PUT",
        "/api/v1/projects/${project.slug}/files/$stableId",
        contents,
        microMediaType(sourceName),
        credentials.accessToken,
        1048576,
        [
            HttpHeader("X-Micro-File-Name", source.name()),
            HttpHeader("X-Micro-Access", access),
            HttpHeader("X-Micro-Entitlement", entitlement)
        ]
    )
    if (response.succeeded)
        MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microSignup(api: MicroApi, email: string, passwordFromInput: bool): MicroResult {
    val password = microReadSecret(if (passwordFromInput) "" else "Password: ", passwordFromInput)
    if (password.size < 12 || password.size > 256)
        return MicroResult(false, "Password must contain between 12 and 256 characters.")
    if (!passwordFromInput) {
        val confirmation = microReadSecret("Confirm: ")
        if (!microConstantTimeEqual(password, confirmation))
            return MicroResult(false, "Passwords did not match.")
    }
    val registered = microRequest(
        api, "POST", "/api/v1/cli/signup",
        jsonStringify(jsonObject(
            ["email", "password"], [jsonString(email), jsonString(password)]
        ))
    )
    if (!registered.succeeded) return MicroResult(false, registered.message)
    val parsed = jsonParse(registered.response.body)
    val credentials = if (parsed.succeeded && parsed.value.isObject())
        MicroCredentials(
            parsed.value.getString("access_token") != "" &&
                parsed.value.getString("refresh_token") != "",
            parsed.value.getString("access_token"),
            parsed.value.getString("refresh_token")
        )
        else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "The account was created, but credentials could not be saved securely.")
    else MicroResult(
        true,
        "Account created. Check your email to verify it before the first production deployment.",
        jsonStringify(jsonObject(
            ["ok", "authenticated", "email_verified", "verification_sent"],
            [jsonBoolean(true), jsonBoolean(true), jsonBoolean(false), jsonBoolean(true)]
        ))
    )
}

fun microAccountStatus(api: MicroApi, waitForVerification: bool = false): MicroResult {
    var result = MicroResult(false, "Not logged in.")
    var attempts = 0
    var waiting = true
    while (waiting) {
        val credentials = microRefreshCredentials(api)
        if (!credentials.valid) {
            result = MicroResult(false, "Not logged in.")
            waiting = false
        } else {
            val response = microRequest(
                api, "GET", "/api/v1/auth/status", "", "application/json",
                credentials.accessToken
            )
            if (!response.succeeded) {
                result = MicroResult(false, response.message)
                waiting = false
            } else {
                val parsed = jsonParse(response.response.body)
                val verified = parsed.succeeded && parsed.value.isObject() &&
                    parsed.value.get("email_verified").asBoolean()
                result = MicroResult(true, response.response.body, response.response.body)
                attempts = attempts + 1
                waiting = waitForVerification && !verified && attempts < 300
                if (waiting) sleep(1000)
                if (waitForVerification && !verified && attempts >= 300) {
                    result = MicroResult(false, "Email verification timed out.", response.response.body)
                }
            }
        }
    }
    result
}

fun microLogin(api: MicroApi): MicroResult {
    var listener = tcpListenAddress(ipv4SocketAddress("127.0.0.1", 0), 8)
    if (listener.descriptor < 0) return MicroResult(false, "Could not open the loopback callback server.")
    val port = listener.localPort()
    val state = microRandomToken(32)
    val verifier = microRandomToken(48)
    val challenge = microBase64UrlEncode(sha256(verifier))
    if (port <= 0 || state == "" || verifier == "") {
        listener.close()
        return MicroResult(false, "Could not create secure pairing state.")
    }
    val redirect = "http://127.0.0.1:$port/callback"
    val started = microRequest(
        api, "POST", "/api/v1/cli/pair/start",
        jsonStringify(jsonObject(
            ["state", "code_challenge", "redirect_uri"],
            [jsonString(state), jsonString(challenge), jsonString(redirect)]
        ))
    )
    if (!started.succeeded) {
        listener.close()
        return MicroResult(false, started.message)
    }
    val parsed = jsonParse(started.response.body)
    val pairingId = if (parsed.succeeded) parsed.value.getString("pairing_id") else ""
    val authorizeUrl = if (parsed.succeeded) parsed.value.getString("authorize_url") else ""
    if (pairingId == "" || authorizeUrl == "") {
        listener.close()
        return MicroResult(false, "micro.do returned an invalid pairing response.")
    }
    linuxWriteStandardOutputAll("Opening $authorizeUrl\n")
    if (linuxCommand("xdg-open").argument(authorizeUrl).run() != 0)
        linuxWriteStandardOutputAll("Open that URL in your browser to continue.\n")
    val readiness = linuxPollSocket(listener.descriptor, true, false, 300000)
    if (!readiness.readable) {
        listener.close()
        return MicroResult(false, "Browser authorization timed out.")
    }
    val connection = listener.accept()
    listener.close()
    if (connection.descriptor < 0) return MicroResult(false, "Could not accept the browser callback.")
    val callback = httpParseRequest(httpReadRequest(connection, 8192, 0))
    val callbackState = microQueryParameter(callback, "state")
    val callbackPairing = microQueryParameter(callback, "pairing_id")
    val code = microQueryParameter(callback, "code")
    val callbackValid = callback.path == "/callback" && callbackState == state &&
        callbackPairing == pairingId && code != ""
    val callbackBody = if (callbackValid)
        "<!doctype html><title>micro CLI paired</title><p>You can close this window and return to the terminal.</p>"
        else "<!doctype html><title>micro CLI pairing failed</title><p>The callback did not match this pairing request.</p>"
    val callbackResponse = HttpResponse(
        if (callbackValid) 200 else 400,
        [HttpHeader("Content-Type", "text/html; charset=utf-8")],
        callbackBody
    )
    connection.write(callbackResponse.render())
    connection.close()
    if (!callbackValid) return MicroResult(false, "Browser callback state did not match.")
    val exchanged = microRequest(
        api, "POST", "/api/v1/cli/pair/exchange",
        jsonStringify(jsonObject(
            ["pairing_id", "state", "code", "code_verifier"],
            [jsonString(pairingId), jsonString(state), jsonString(code), jsonString(verifier)]
        ))
    )
    if (!exchanged.succeeded) return MicroResult(false, exchanged.message)
    val tokens = jsonParse(exchanged.response.body)
    val credentials = if (tokens.succeeded) MicroCredentials(
        tokens.value.getString("access_token") != "" && tokens.value.getString("refresh_token") != "",
        tokens.value.getString("access_token"), tokens.value.getString("refresh_token")
    ) else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "Could not securely save the paired credentials.")
    else MicroResult(true, "Paired with micro.do.")
}

fun microLogout(api: MicroApi): MicroResult {
    val target = microCredentialsPath()
    if (!target.exists()) MicroResult(true, "Already logged out.")
    else {
        val credentials = microRefreshCredentials(api)
        val revoked = if (credentials.valid) microRequest(
            api, "POST", "/api/v1/auth/logout", "", "application/json",
            credentials.accessToken
        ) else MicroHttpResult(false, HttpResponse(0, [], ""), "Could not refresh the session.")
        val removed = target.remove()
        if (!removed) MicroResult(false, "Could not remove local credentials.")
        else if (!revoked.succeeded) MicroResult(
            false,
            "Removed local credentials, but could not revoke the remote session: ${revoked.message}"
        )
        else MicroResult(true, "Logged out and revoked the micro.do session.")
    }
}

fun microDeploy(api: MicroApi, slug: string, fileName: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val artifactPath = path(fileName)
    val artifact = artifactPath.readText()
    if (!artifactPath.exists() || artifact == "")
        return MicroResult(false, "Could not read $fileName.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val deployed = microRequest(
        api, "PUT", "/api/v1/functions/$slug", artifact, "application/wasm",
        credentials.accessToken, 1048576
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val deployment = parsed.value.getString("deployment_id")
    val digest = parsed.value.getString("artifact_sha256")
    MicroResult(true, "$url\ndeployment $deployment · sha256 $digest")
}

fun microFunctions(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/functions", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body)
    else MicroResult(false, response.message)
}

fun microDeploySite(
    api: MicroApi,
    slug: string,
    preview: bool,
    acceptPriceChanges: bool = false,
    acceptLiveProducts: bool = false
): MicroResult {
    if (!preview && !microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val built = microBuildProject(path("."))
    if (!built.succeeded) return built
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    var baseRevision = ""
    if (!preview) {
        val linked = microLocalProject()
        if (linked.valid && linked.slug == slug) {
            val local = jsonParse(path(".micro/project.json").readText())
            if (local.succeeded && local.value.getString("source_sha256") != "")
                baseRevision = local.value.getString("source_sha256")
        }
    }
    microUploadSite(
        api, slug, preview, credentials.accessToken, baseRevision,
        acceptPriceChanges, acceptLiveProducts
    )
}

fun microUploadSite(
    api: MicroApi,
    slug: string,
    preview: bool,
    bearer: string,
    baseRevision: string,
    acceptPriceChanges: bool,
    acceptLiveProducts: bool
): MicroResult {
    val bundle = path(".micro/bundle.json").readText()
    if (bundle == "") return MicroResult(false, "Could not read .micro/bundle.json.")
    val deploymentHeaders: array<HttpHeader> = []
    if (!preview && baseRevision != "")
        deploymentHeaders.append(HttpHeader("If-Match", baseRevision))
    if (!preview && acceptPriceChanges)
        deploymentHeaders.append(HttpHeader("X-Micro-Accept-Price-Changes", "true"))
    if (!preview && acceptLiveProducts)
        deploymentHeaders.append(HttpHeader("X-Micro-Accept-Live-Products", "true"))
    val deployed = microRequest(
        api,
        if (preview) "POST" else "PUT",
        if (preview) "/api/v1/previews" else "/api/v1/projects/$slug/deployments",
        bundle,
        "application/json",
        bearer,
        1048576,
        deploymentHeaders
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val bundleDigest = parsed.value.getString("bundle_sha256")
    val sourceDigest = parsed.value.getString("source_sha256")
    if (url == "" || bundleDigest == "" || sourceDigest == "")
        return MicroResult(false, "micro.do omitted deployment identifiers.")
    if (preview) {
        val previewId = parsed.value.getString("preview_id")
        MicroResult(true, "$url\npreview $previewId · bundle $bundleDigest", deployed.response.body)
    } else {
        val projectId = parsed.value.getString("project_id")
        val deploymentId = parsed.value.getString("deployment_id")
        val state = jsonStringify(jsonObject(
            ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
            [jsonString(projectId), jsonString(slug), jsonString(deploymentId),
             jsonString(bundleDigest), jsonString(sourceDigest)]
        ))
        if (!path(".micro/project.json").writeTextAtomic(state))
            return MicroResult(false, "The site deployed, but local project state could not be saved.\n$url\ndeployment $deploymentId")
        MicroResult(true, "$url\ndeployment $deploymentId · bundle $bundleDigest", deployed.response.body)
    }
}

class MicroGithubAuthorization(
    val valid: bool,
    val accessToken: string,
    val slug: string,
    val baseRevision: string,
    val message: string
)

fun microGithubTokenValid(value: string): bool =
    value.size >= 40 && value.size <= 256 && value.slice(0, 4) == "mda_"

fun microGithubAuthorization(api: MicroApi): MicroGithubAuthorization {
    val configured = linuxEnvironment("MICRO_GITHUB_OIDC_TOKEN")
    if (!configured.found || configured.value.size < 100 || configured.value.size > 32768)
        return MicroGithubAuthorization(false, "", "", "", "GitHub Actions OIDC token is unavailable.")
    val binding = jsonParse(path("micro.github.json").readText())
    if (!binding.succeeded || !binding.value.isObject() ||
        binding.value.getString("binding_id").size != 36)
        return MicroGithubAuthorization(false, "", "", "", "micro.github.json is missing or invalid; run `micro github link` and commit it.")
    val exchanged = microRequest(
        api, "POST", "/api/v1/actions/exchange",
        jsonStringify(jsonObject(
            ["binding_id", "oidc_token"],
            [jsonString(binding.value.getString("binding_id")), jsonString(configured.value)]
        )),
        "application/json", "", 1048576
    )
    if (!exchanged.succeeded)
        return MicroGithubAuthorization(false, "", "", "", exchanged.message)
    val parsed = jsonParse(exchanged.response.body)
    if (!parsed.succeeded || !parsed.value.isObject() ||
        !microSlugValid(parsed.value.getString("slug")) ||
        !microGithubTokenValid(parsed.value.getString("access_token")))
        return MicroGithubAuthorization(false, "", "", "", "micro.do returned invalid GitHub deployment authorization.")
    MicroGithubAuthorization(
        true, parsed.value.getString("access_token"), parsed.value.getString("slug"),
        parsed.value.getString("base_revision"), ""
    )
}

fun microDeployGithub(api: MicroApi): MicroResult {
    val built = microBuildProject(path("."))
    if (!built.succeeded) return built
    val authorization = microGithubAuthorization(api)
    if (!authorization.valid) return MicroResult(false, authorization.message)
    val priceChanges = linuxEnvironment("MICRO_ACCEPT_PRICE_CHANGES")
    val liveProducts = linuxEnvironment("MICRO_ACCEPT_LIVE_PRODUCTS")
    microUploadSite(
        api, authorization.slug, false, authorization.accessToken,
        authorization.baseRevision,
        priceChanges.found && priceChanges.value == "true",
        liveProducts.found && liveProducts.value == "true"
    )
}

fun microGithubLink(
    api: MicroApi,
    repository: string,
    environment: string,
    gitRef: string,
    slug: string
): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "POST", "/api/v1/github/bindings",
        jsonStringify(jsonObject(
            ["repository", "environment", "ref", "slug"],
            [jsonString(repository), jsonString(environment), jsonString(gitRef), jsonString(slug)]
        )), "application/json", credentials.accessToken
    )
    if (!response.succeeded) return MicroResult(false, response.message)
    val parsed = jsonParse(response.response.body)
    val bindingId = if (parsed.succeeded) parsed.value.getString("id") else ""
    if (bindingId.size != 36)
        return MicroResult(false, "micro.do returned an invalid GitHub binding.")
    val state = jsonStringify(jsonObject(
        ["binding_id", "repository", "environment", "ref", "slug"],
        [jsonString(bindingId), jsonString(repository), jsonString(environment),
         jsonString(gitRef), jsonString(slug)]
    ))
    if (!path("micro.github.json").writeTextAtomic(state))
        return MicroResult(false, "GitHub was linked, but micro.github.json could not be written.", response.response.body)
    MicroResult(true, response.response.body, response.response.body)
}

fun microGithubBindings(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/github/bindings", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body, response.response.body)
    else MicroResult(false, response.message)
}

fun microGithubRevoke(api: MicroApi, binding: string): MicroResult {
    if (binding.size != 36) return MicroResult(false, "GitHub binding ID is invalid.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "POST", "/api/v1/github/bindings/$binding/revoke", "{}",
        "application/json", credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, "Revoked GitHub deployment binding.")
    else MicroResult(false, response.message)
}

