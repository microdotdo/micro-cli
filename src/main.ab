    role: string,
    canPromote: bool
): MicroResult {
    if (!microProjectRoleValid(role) || (role == "viewer" && canPromote))
        return MicroResult(false, "Role must be viewer, developer, or admin; viewers cannot promote.")
    microLinkedOperation(
        api, "POST", "/invitations",
        jsonStringify(jsonObject(
            ["email", "role", "can_promote"],
            [jsonString(email), jsonString(role), jsonBoolean(canPromote)]
        ))
    )
}

fun microRevokeProjectInvitation(
    api: MicroApi,
    invitationId: string,
    confirmed: bool
): MicroResult {
    if (!confirmed) return MicroResult(false, "Revoking a project invitation requires --confirm.")
    if (!microUuidValid(invitationId)) return MicroResult(false, "Invitation ID must be a UUID.")
    microLinkedOperation(
        api, "DELETE", "/invitations/$invitationId", "", "Revoked the project invitation."
    )
}

fun microAcceptProjectInvitation(api: MicroApi, tokenFromStdin: bool): MicroResult {
    if (!tokenFromStdin)
        return MicroResult(false, "Invitation tokens must be supplied with --token-stdin.")
    val token = microReadSecret("", true)
    if (token.size < 32 || token.size > 256)
        return MicroResult(false, "The invitation token is invalid.")
    microAuthenticatedRequest(
        api, "POST", "/api/v1/invitations/accept",
        jsonStringify(jsonObject(["token"], [jsonString(token)]))
    )
}

