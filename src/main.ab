    else if (command == "deployments" && index + 1 == count) microProjectDeployments(api)
    else if (command == "logs" && index + 3 == count &&
        linuxArgument(index + 1) == "--since")
        microProjectLogs(api, linuxArgument(index + 2))
    else if (command == "users" && index + 1 == count) microUsers(api)
    else if (command == "users" && index + 4 == count &&
        linuxArgument(index + 1) == "disable" &&
        linuxArgument(index + 3) == "--confirm")
