import "core.ab"
import "project.ab"

fun microUsage(): string = "micro 0.2.0\n\nBuild and deploy small full-stack sites to micro.do\n\nUsage:\n  micro [--api URL] new <directory>\n  micro [--api URL] build\n  micro [--api URL] signup --email <email> [--password-stdin]\n  micro [--api URL] login\n  micro [--api URL] logout\n  micro [--api URL] account status\n  micro [--api URL] deploy --preview\n  micro [--api URL] deploy <slug>\n  micro [--api URL] projects\n"

fun microSignup(api: MicroApi, email: string, passwordFromInput: bool): MicroResult {
    val password = microReadSecret(if (passwordFromInput) "" else "Password: ", passwordFromInput)
    if (password.size < 12 || password.size > 256)
        return MicroResult(false, "Password must contain between 12 and 256 characters.")
    if (!passwordFromInput) {
        val confirmation = microReadSecret("Confirm: ")
        if (!microConstantTimeEqual(password, confirmation))
            return MicroResult(false, "Passwords did not match.")
    }
    val registered = microRequest(
        api, "POST", "/api/v1/cli/signup",
        jsonStringify(jsonObject(
            ["email", "password"], [jsonString(email), jsonString(password)]
        ))
    )
    if (!registered.succeeded) return MicroResult(false, registered.message)
    val parsed = jsonParse(registered.response.body)
    val credentials = if (parsed.succeeded && parsed.value.isObject())
        MicroCredentials(
            parsed.value.getString("access_token") != "" &&
                parsed.value.getString("refresh_token") != "",
            parsed.value.getString("access_token"),
            parsed.value.getString("refresh_token")
        )
        else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "The account was created, but credentials could not be saved securely.")
    else MicroResult(true, "Account created. Check your email to verify it before the first production deployment.")
}

fun microAccountStatus(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in.")
    val response = microRequest(
        api, "GET", "/api/v1/auth/status", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body)
    else MicroResult(false, response.message)
}

fun microLogin(api: MicroApi): MicroResult {
    var listener = tcpListenAddress(ipv4SocketAddress("127.0.0.1", 0), 8)
    if (listener.descriptor < 0) return MicroResult(false, "Could not open the loopback callback server.")
    val port = listener.localPort()
    val state = microRandomToken(32)
    val verifier = microRandomToken(48)
    val challenge = microBase64UrlEncode(sha256(verifier))
    if (port <= 0 || state == "" || verifier == "") {
        listener.close()
        return MicroResult(false, "Could not create secure pairing state.")
    }
    val redirect = "http://127.0.0.1:$port/callback"
    val started = microRequest(
        api, "POST", "/api/v1/cli/pair/start",
        jsonStringify(jsonObject(
            ["state", "code_challenge", "redirect_uri"],
            [jsonString(state), jsonString(challenge), jsonString(redirect)]
        ))
    )
    if (!started.succeeded) {
        listener.close()
        return MicroResult(false, started.message)
    }
    val parsed = jsonParse(started.response.body)
    val pairingId = if (parsed.succeeded) parsed.value.getString("pairing_id") else ""
    val authorizeUrl = if (parsed.succeeded) parsed.value.getString("authorize_url") else ""
    if (pairingId == "" || authorizeUrl == "") {
        listener.close()
        return MicroResult(false, "micro.do returned an invalid pairing response.")
    }
    linuxWriteStandardOutputAll("Opening $authorizeUrl\n")
    if (linuxCommand("xdg-open").argument(authorizeUrl).run() != 0)
        linuxWriteStandardOutputAll("Open that URL in your browser to continue.\n")
    val readiness = linuxPollSocket(listener.descriptor, true, false, 300000)
    if (!readiness.readable) {
        listener.close()
        return MicroResult(false, "Browser authorization timed out.")
    }
    val connection = listener.accept()
    listener.close()
    if (connection.descriptor < 0) return MicroResult(false, "Could not accept the browser callback.")
    val callback = httpParseRequest(httpReadRequest(connection, 8192, 0))
    val callbackState = microQueryParameter(callback, "state")
    val callbackPairing = microQueryParameter(callback, "pairing_id")
    val code = microQueryParameter(callback, "code")
    val callbackValid = callback.path == "/callback" && callbackState == state &&
        callbackPairing == pairingId && code != ""
    val callbackBody = if (callbackValid)
        "<!doctype html><title>micro CLI paired</title><p>You can close this window and return to the terminal.</p>"
        else "<!doctype html><title>micro CLI pairing failed</title><p>The callback did not match this pairing request.</p>"
    val callbackResponse = HttpResponse(
        if (callbackValid) 200 else 400,
        [HttpHeader("Content-Type", "text/html; charset=utf-8")],
        callbackBody
    )
    connection.write(callbackResponse.render())
    connection.close()
    if (!callbackValid) return MicroResult(false, "Browser callback state did not match.")
    val exchanged = microRequest(
        api, "POST", "/api/v1/cli/pair/exchange",
        jsonStringify(jsonObject(
            ["pairing_id", "state", "code", "code_verifier"],
            [jsonString(pairingId), jsonString(state), jsonString(code), jsonString(verifier)]
        ))
    )
    if (!exchanged.succeeded) return MicroResult(false, exchanged.message)
    val tokens = jsonParse(exchanged.response.body)
    val credentials = if (tokens.succeeded) MicroCredentials(
        tokens.value.getString("access_token") != "" && tokens.value.getString("refresh_token") != "",
        tokens.value.getString("access_token"), tokens.value.getString("refresh_token")
    ) else MicroCredentials(false, "", "")
    if (!credentials.valid || !microSaveCredentials(credentials))
        MicroResult(false, "Could not securely save the paired credentials.")
    else MicroResult(true, "Paired with micro.do.")
}

fun microLogout(): MicroResult {
    val target = microCredentialsPath()
    if (!target.exists()) MicroResult(true, "Already logged out.")
    else if (target.remove()) MicroResult(true, "Removed local micro.do credentials.")
    else MicroResult(false, "Could not remove local credentials.")
}

fun microDeploy(api: MicroApi, slug: string, fileName: string): MicroResult {
    if (!microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val artifactPath = path(fileName)
    val artifact = artifactPath.readText()
    if (!artifactPath.exists() || artifact == "")
        return MicroResult(false, "Could not read $fileName.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val deployed = microRequest(
        api, "PUT", "/api/v1/functions/$slug", artifact, "application/wasm",
        credentials.accessToken, 1048576
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val deployment = parsed.value.getString("deployment_id")
    val digest = parsed.value.getString("artifact_sha256")
    MicroResult(true, "$url\ndeployment $deployment · sha256 $digest")
}

fun microFunctions(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/functions", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body)
    else MicroResult(false, response.message)
}

fun microDeploySite(api: MicroApi, slug: string, preview: bool): MicroResult {
    if (!preview && !microSlugValid(slug))
        return MicroResult(false, "Slug must contain 3-63 lowercase letters, digits, or interior hyphens and must not be reserved.")
    val built = microBuildProject(path("."))
    if (!built.succeeded) return built
    val bundle = path(".micro/bundle.json").readText()
    if (bundle == "") return MicroResult(false, "Could not read .micro/bundle.json.")
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val deployed = microRequest(
        api,
        if (preview) "POST" else "PUT",
        if (preview) "/api/v1/previews" else "/api/v1/projects/$slug/deployments",
        bundle,
        "application/json",
        credentials.accessToken,
        1048576
    )
    if (!deployed.succeeded) return MicroResult(false, deployed.message)
    val parsed = jsonParse(deployed.response.body)
    if (!parsed.succeeded || !parsed.value.isObject())
        return MicroResult(false, "micro.do returned an invalid deployment response.")
    val url = parsed.value.getString("url")
    val bundleDigest = parsed.value.getString("bundle_sha256")
    val sourceDigest = parsed.value.getString("source_sha256")
    if (url == "" || bundleDigest == "" || sourceDigest == "")
        return MicroResult(false, "micro.do omitted deployment identifiers.")
    if (preview) {
        val previewId = parsed.value.getString("preview_id")
        MicroResult(true, "$url\npreview $previewId · bundle $bundleDigest")
    } else {
        val projectId = parsed.value.getString("project_id")
        val deploymentId = parsed.value.getString("deployment_id")
        val state = jsonStringify(jsonObject(
            ["project_id", "slug", "deployment_id", "bundle_sha256", "source_sha256"],
            [jsonString(projectId), jsonString(slug), jsonString(deploymentId),
             jsonString(bundleDigest), jsonString(sourceDigest)]
        ))
        if (!path(".micro/project.json").writeTextAtomic(state))
            return MicroResult(false, "The site deployed, but local project state could not be saved.\n$url\ndeployment $deploymentId")
        MicroResult(true, "$url\ndeployment $deploymentId · bundle $bundleDigest")
    }
}

fun microProjects(api: MicroApi): MicroResult {
    val credentials = microRefreshCredentials(api)
    if (!credentials.valid) return MicroResult(false, "Not logged in; run `micro login`.")
    val response = microRequest(
        api, "GET", "/api/v1/projects", "", "application/json",
        credentials.accessToken
    )
    if (response.succeeded) MicroResult(true, response.response.body)
    else MicroResult(false, response.message)
}

fun microRun(): MicroResult {
    val count = linuxArgumentCount()
    var apiValue = "https://micro.do"
    val configured = linuxEnvironment("MICRO_API")
    if (configured.found && configured.value != "") apiValue = configured.value
    var index = 0
    if (index < count && linuxArgument(index) == "--api") {
        if (index + 1 >= count) return MicroResult(false, "--api requires a URL.\n${microUsage()}")
        apiValue = linuxArgument(index + 1)
        index = index + 2
    }
    if (index >= count || linuxArgument(index) == "--help" || linuxArgument(index) == "-h")
        return MicroResult(true, microUsage())
    if (linuxArgument(index) == "--version" || linuxArgument(index) == "-V")
        return MicroResult(true, "micro 0.2.0")
    val api = microParseApi(apiValue)
    if (!api.valid) return MicroResult(false, api.message)
    val command = linuxArgument(index)
    if (command == "new" && index + 2 == count)
        microNewProject(linuxArgument(index + 1))
    else if (command == "build" && index + 1 == count)
        microBuildProject(path("."))
    else if (command == "signup" && index + 3 == count &&
        linuxArgument(index + 1) == "--email")
        microSignup(api, linuxArgument(index + 2), false)
    else if (command == "signup" && index + 4 == count &&
        linuxArgument(index + 1) == "--email" &&
        linuxArgument(index + 3) == "--password-stdin")
        microSignup(api, linuxArgument(index + 2), true)
    else if (command == "account" && index + 2 == count &&
        linuxArgument(index + 1) == "status")
        microAccountStatus(api)
    else if (command == "login" && index + 1 == count) microLogin(api)
    else if (command == "logout" && index + 1 == count) microLogout()
    else if (command == "projects" && index + 1 == count) microProjects(api)
    else if (command == "deploy" && index + 2 == count &&
        linuxArgument(index + 1) == "--preview")
        microDeploySite(api, "", true)
    else if (command == "deploy" && index + 2 == count)
        microDeploySite(api, linuxArgument(index + 1), false)
    else MicroResult(false, "Invalid command.\n${microUsage()}")
}

fun main: int {
    val result = microRun()
    if (result.succeeded) {
        linuxWriteStandardOutputAll("${result.message}\n")
        0
    } else {
        linuxWriteStandardErrorAll("micro: ${result.message}\n")
        1
    }
}
