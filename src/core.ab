import "abla/crypto"
import "abla/fs"
import "abla/http"
import "abla/http/tls"
import "abla/json"
import "abla/random"
import "abla/sys/linux"
import "abla/sys/linux/io"

class MicroApi(
    val valid: bool,
    val secure: bool,
    val host: string,
    val port: int,
    val origin: string,
    val message: string
)

class MicroCredentials(
    val valid: bool,
    val accessToken: string,
    val refreshToken: string
)

class MicroResult(
    val succeeded: bool,
    val message: string,
    val structured: string = ""
)

class MicroHttpResult(
    val succeeded: bool,
    val response: HttpResponse,
    val message: string
)

fun microConstantTimeEqual(left: string, right: string): bool {
    var difference = left.size ^ right.size
    val maximum = if (left.size > right.size) left.size else right.size
    var index = 0
    while (index < maximum) {
        val a = if (index < left.size) left[index] else 0
        val b = if (index < right.size) right[index] else 0
        difference = difference | (a ^ b)
        index = index + 1
    }
    difference == 0
}

fun microLoadU32(buffer: NativeByteBuffer, offset: int): int =
    buffer.load(offset) + buffer.load(offset + 1) * 256 +
    buffer.load(offset + 2) * 65536 + buffer.load(offset + 3) * 16777216

fun microStoreU32(var buffer: NativeByteBuffer, offset: int, value: int): void {
    buffer.store(offset, value & 255)
    buffer.store(offset + 1, (value >>> 8) & 255)
    buffer.store(offset + 2, (value >>> 16) & 255)
    buffer.store(offset + 3, (value >>> 24) & 255)
    return
}

fun microReadSecret(prompt: string, standardInput: bool = false): string {
    if (prompt != "") linuxWriteStandardErrorAll(prompt)
    val terminal = nativeByteBuffer(64)
    var echoDisabled = false
    if (!standardInput) {
        val read = linuxSyscall3(16, 0, 21505, nativePointerAddress(terminal.address))
        if (read == 0) {
            val flags = microLoadU32(terminal, 12)
            microStoreU32(terminal, 12, flags & (~8))
            echoDisabled = linuxSyscall3(
                16, 0, 21506, nativePointerAddress(terminal.address)
            ) == 0
            microStoreU32(terminal, 12, flags)
        }
    }
    val password = linuxStandardInput().readLine().text
    if (echoDisabled) {
        linuxSyscall3(16, 0, 21506, nativePointerAddress(terminal.address))
        linuxWriteStandardErrorAll("\n")
    }
    terminal.close()
    password
}

fun microBase64UrlEncode(value: string): string {
    val encoded = base64Encode(value)
    var result = ""
    var index = 0
    while (index < encoded.size && encoded[index] != 61) {
        if (encoded[index] == 43) result = "${result}-"
        else if (encoded[index] == 47) result = "${result}_"
        else result = "$result${encoded.slice(index, index + 1)}"
        index = index + 1
    }
    result
}

fun microRandomToken(bytes: int): string {
    val entropy = secureRandomBytes(bytes)
    if (entropy.succeeded) microBase64UrlEncode(entropy.bytes) else ""
}

fun microParsePort(value: string, fallback: int): int {
    var parsed = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9) valid = false
        else parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid && parsed > 0 && parsed <= 65535) parsed else fallback
}

fun microUuidValid(value: string): bool {
    if (value.size != 36) return false
    var valid = true
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        val hyphen = index == 8 || index == 13 || index == 18 || index == 23
        val hex = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 70) ||
            (byte >= 97 && byte <= 102)
        valid = if (hyphen) byte == 45 else hex
        index = index + 1
    }
    valid
}

fun microSha256Valid(value: string): bool {
    if (value.size != 64) return false
    var valid = true
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        valid = (byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)
        index = index + 1
    }
    valid
}

fun microPositiveInt(value: string, fallback: int, maximum: int = 2147483647): int {
    var parsed = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9 || parsed > (maximum - digit) / 10) valid = false
        else parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid && parsed > 0 && parsed <= maximum) parsed else fallback
}

fun microNonNegativeInt(value: string, fallback: int, maximum: int): int {
    var parsed = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9 || parsed > (maximum - digit) / 10) valid = false
        else parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid && parsed >= 0 && parsed <= maximum) parsed else fallback
}

fun microDataNameValid(value: string, maximum: int): bool {
    var valid = value.size >= 1 && value.size <= maximum
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        valid = (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 45 || byte == 95 || byte == 46
        index = index + 1
    }
    valid
}

fun microRecordScopeValid(value: string): bool {
    if (value == "project") return true
    if (value.size != 41 || value.slice(0, 5) != "user:") return false
    microUuidValid(value.slice(5, value.size))
}

fun microRetentionPolicyValid(recordDays: int, automatic: bool): bool =
    (recordDays == 0 || (recordDays >= 30 && recordDays <= 3650)) &&
    (!automatic || recordDays >= 30)

fun microProjectDeletionConfirmationValid(
    projectId: string,
    linkedSlug: string,
    confirmedSlug: string,
    confirmed: bool
): bool = confirmed && microUuidValid(projectId) && microSlugValid(linkedSlug) &&
    confirmedSlug == linkedSlug

fun microParseApi(value: string): MicroApi {
    var origin = value
    while (origin.size > 0 && origin[origin.size - 1] == 47)
        origin = origin.slice(0, origin.size - 1)
    var secure = false
    var authorityBegin = -1
    if (origin.size > 8 && origin.slice(0, 8) == "https://") {
        secure = true
        authorityBegin = 8
    } else if (origin.size > 7 && origin.slice(0, 7) == "http://") {
        authorityBegin = 7
    }
    var valid = authorityBegin >= 0 && authorityBegin < origin.size
    var colon = -1
    var index = if (authorityBegin >= 0) authorityBegin else 0
    while (valid && index < origin.size) {
        if (origin[index] == 47 || origin[index] == 63 || origin[index] == 35 ||
            origin[index] == 64) valid = false
        if (origin[index] == 58) {
            if (colon >= 0) valid = false
            colon = index
        }
        index = index + 1
    }
    val hostEnd = if (colon >= 0) colon else origin.size
    val host = if (valid) origin.slice(authorityBegin, hostEnd) else ""
    val defaultPort = if (secure) 443 else 80
    val port = if (colon >= 0) microParsePort(origin.slice(colon + 1, origin.size), -1)
        else defaultPort
    val local = host == "127.0.0.1" || host == "localhost"
    valid = valid && host != "" && port > 0 && (secure || local)
    MicroApi(
        valid, secure, host, port, origin,
        if (valid) "" else "API URL must use HTTPS (HTTP is allowed only for localhost)."
    )
}

fun MicroApi.client(maximumResponseBytes: int = 1048576): HttpClient {
    if (this.secure) httpsClient(this.host, this.port, maximumResponseBytes, 10000)
    else httpIpv4Client(
        if (this.port == 80) this.host else "${this.host}:${this.port}",
        if (this.host == "localhost") "127.0.0.1" else this.host,
        this.port,
        maximumResponseBytes,
        10000
    )
}

fun microResponseMessage(response: HttpResponse): string {
    val parsed = jsonParse(response.body)
    if (parsed.succeeded && parsed.value.isObject() && parsed.value.getString("message") != "")
        parsed.value.getString("message")
    else if (response.body != "") response.body else "request failed"
}

fun microChecked(result: HttpClientResult): MicroHttpResult {
    if (!result.succeeded || !result.complete)
        MicroHttpResult(false, result.response, "Could not reach micro.do.")
    else if (result.response.status < 200 || result.response.status >= 300) {
        val prefix = if (result.response.status == 401) "Not authorized: "
            else "micro.do returned ${result.response.status}: "
        MicroHttpResult(false, result.response, "$prefix${microResponseMessage(result.response)}")
    } else MicroHttpResult(true, result.response, "")
}

fun microRequest(
    api: MicroApi,
    method: string,
    endpoint: string,
    body: string = "",
    contentType: string = "application/json",
    bearer: string = "",
    maximumResponseBytes: int = 1048576,
    extraHeaders: array<HttpHeader> = []
): MicroHttpResult {
    val headers: array<HttpHeader> = [
        HttpHeader("User-Agent", "micro-cli/0.10.0"),
        HttpHeader("Content-Type", contentType)
    ]
    if (bearer != "") headers.append(HttpHeader("Authorization", "Bearer $bearer"))
    var index = 0
    while (index < extraHeaders.size) {
        headers.append(extraHeaders[index])
        index = index + 1
    }
    microChecked(api.client(maximumResponseBytes).send(
        httpRequest(method, endpoint, body, headers)
    ))
}

fun microSlugValid(value: string): bool {
    var valid = value.size >= 3 && value.size <= 63
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        if (!((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            (byte == 45 && index > 0 && index + 1 < value.size))) valid = false
        index = index + 1
    }
    val reserved = value == "api" || value == "auth" || value == "autoconfig" ||
        value == "autodiscover" || value == "cli" || value == "custom" || value == "mail" ||
        value == "micro" || value == "runner" || value == "status" || value == "www"
    valid && !reserved && !(value.size >= 2 && value.slice(0, 2) == "p-")
}

fun microQueryParameter(request: HttpRequest, name: string): string {
    var result = ""
    var begin = 0
    var cursor = 0
    while (cursor <= request.query.size) {
        if (cursor == request.query.size || request.query[cursor] == 38) {
            var equals = begin
            while (equals < cursor && request.query[equals] != 61) equals = equals + 1
            if (equals < cursor && request.query.slice(begin, equals) == name)
                result = request.query.slice(equals + 1, cursor)
            begin = cursor + 1
        }
        cursor = cursor + 1
    }
    result
}

fun microCredentialsPath(): Path {
    val configured = linuxEnvironment("XDG_CONFIG_HOME")
    val home = linuxEnvironment("HOME")
    val root = if (configured.found && configured.value != "") configured.value
        else if (home.found && home.value != "") "${home.value}/.config"
        else "."
    path("$root/micro-cli/credentials.json")
}

fun microCredentialsLockPath(): Path =
    microCredentialsPath().parent().child("credentials.lock")

fun microLoadCredentials(): MicroCredentials {
    val contents = microCredentialsPath().readText()
    val parsed = jsonParse(contents)
    if (parsed.succeeded && parsed.value.isObject()) {
        val access = parsed.value.getString("access_token")
        val refresh = parsed.value.getString("refresh_token")
        MicroCredentials(access != "" && refresh != "", access, refresh)
    } else MicroCredentials(false, "", "")
}

fun microSaveCredentials(credentials: MicroCredentials): bool {
    val target = microCredentialsPath()
    var succeeded = target.createParentDirectories()
    if (succeeded) succeeded = linuxSyscall2(
        90, nativeCStringAddress(target.parent().text), 448
    ) == 0
    var descriptor = -1
    if (succeeded) descriptor = linuxOpen(target.text, 577, 384).descriptor
    val encoded = jsonStringify(jsonObject(
        ["access_token", "refresh_token"],
        [jsonString(credentials.accessToken), jsonString(credentials.refreshToken)]
    ))
    if (descriptor < 0) succeeded = false
    if (succeeded) succeeded = linuxWriteAll(descriptor, encoded)
    if (descriptor >= 0) linuxSyscall1(3, descriptor)
    if (succeeded) succeeded = linuxSyscall2(
        90, nativeCStringAddress(target.text), 384
    ) == 0
    succeeded
}

fun microRefreshCredentials(api: MicroApi): MicroCredentials {
    var refreshed = MicroCredentials(false, "", "")
    val lockPath = microCredentialsLockPath()
    val parentReady = lockPath.createParentDirectories()
    val lock = if (parentReady) linuxOpen(lockPath.text, 66, 384).descriptor
        else -1
    // Refresh tokens rotate on every use. A process-level advisory lock makes
    // concurrent CLI invocations load the newest token after the preceding
    // invocation has atomically saved it.
    val locked = lock >= 0 && linuxSyscall2(73, lock, 2) == 0
    val stored = if (locked) microLoadCredentials()
        else MicroCredentials(false, "", "")
    if (locked && stored.valid) {
        val response = microRequest(
            api, "POST", "/api/v1/auth/refresh", "", "application/json",
            stored.refreshToken
        )
        if (response.succeeded) {
            val parsed = jsonParse(response.response.body)
            if (parsed.succeeded && parsed.value.isObject()) {
                val access = parsed.value.getString("access_token")
                val refresh = parsed.value.getString("refresh_token")
                refreshed = MicroCredentials(access != "" && refresh != "", access, refresh)
                if (refreshed.valid && !microSaveCredentials(refreshed))
                    refreshed = MicroCredentials(false, "", "")
            }
        }
    }
    if (locked) linuxSyscall2(73, lock, 8)
    if (lock >= 0) linuxSyscall1(3, lock)
    refreshed
}
