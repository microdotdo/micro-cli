import "abla/crypto"
import "abla/fs"
import "abla/json"
import "abla/sys/linux"

class MicroProjectFile(
    val path: string,
    val contents: string,
    val mediaType: string
)

class MicroFileCollection(
    val succeeded: bool,
    val files: array<MicroProjectFile>,
    val message: string
)

class MicroProductDefinitions(
    val succeeded: bool,
    val slug: string,
    val apiProducts: Json,
    val bundleProducts: Json,
    val message: string
)

fun microTrim(value: string): string {
    var begin = 0
    var end = value.size
    while (begin < end && (value[begin] == 32 || value[begin] == 9 ||
        value[begin] == 13)) begin = begin + 1
    while (end > begin && (value[end - 1] == 32 || value[end - 1] == 9 ||
        value[end - 1] == 13)) end = end - 1
    value.slice(begin, end)
}

fun microYamlScalar(value: string): string {
    val trimmed = microTrim(value)
    if (trimmed.size >= 2 &&
        ((trimmed[0] == 34 && trimmed[trimmed.size - 1] == 34) ||
         (trimmed[0] == 39 && trimmed[trimmed.size - 1] == 39)))
        trimmed.slice(1, trimmed.size - 1)
    else trimmed
}

fun microPositiveInteger(value: string): int {
    var result = 0
    var valid = value != ""
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9 || result > 214748364) valid = false
        else result = result * 10 + digit
        index = index + 1
    }
    if (valid && result > 0) result else 0
}

fun microProductIdValid(value: string): bool {
    var valid = value.size >= 2 && value.size <= 64
    var index = 0
    while (valid && index < value.size) {
        val byte = value[index]
        if (!((byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            (byte == 45 && index > 0 && index + 1 < value.size))) valid = false
        index = index + 1
    }
    valid
}

fun microScheduleIntervalValid(value: int): bool = value >= 5 && value <= 10080

fun microScheduleIdValid(value: string): bool {
    if (value.size < 1 || value.size > 64) return false
    var valid = (value[0] >= 97 && value[0] <= 122) ||
        (value[0] >= 48 && value[0] <= 57)
    var index = 1
    while (valid && index < value.size) {
        val byte = value[index]
        valid = (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) ||
            byte == 46 || byte == 95 || byte == 45
        index = index + 1
    }
    valid
}

fun microSchedulePayloadValid(value: string): bool {
    val parsed = jsonParse(value)
    parsed.succeeded && parsed.value.isObject() && jsonStringify(parsed.value).size <= 8192
}

fun microConfiguredProduct(
    id: string,
    name: string,
    description: string,
    price: int,
    currency: string,
    productType: string,
    entitlement: string,
    mode: string,
    bundle: bool
): Json {
    if (bundle) jsonObject(
        ["id", "name", "description", "amount", "currency", "product_type", "entitlement", "mode"],
        [jsonString(id), jsonString(name), jsonString(description), jsonInteger(price),
         jsonString(currency), jsonString(productType), jsonString(entitlement), jsonString(mode)]
    ) else jsonObject(
        ["id", "name", "description", "price", "currency", "type", "entitlement", "mode"],
        [jsonString(id), jsonString(name), jsonString(description), jsonInteger(price),
         jsonString(currency), jsonString(productType), jsonString(entitlement), jsonString(mode)]
    )
}

fun microProductDefinitions(root: Path): MicroProductDefinitions {
    val sourcePath = root.child("micro.yaml")
    if (!sourcePath.exists())
        return MicroProductDefinitions(true, "", jsonArray([]), jsonArray([]), "")
    val source = sourcePath.readText()
    if (source.size > 262144)
        return MicroProductDefinitions(false, "", jsonArray([]), jsonArray([]), "micro.yaml exceeds 256 KiB.")
    val apiProducts: array<Json> = []
    val bundleProducts: array<Json> = []
    val ids: array<string> = []
    var slug = ""
    var inProducts = false
    var productId = ""
    var productName = ""
    var description = ""
    var price = 0
    var currency = ""
    var productType = "one_time"
    var entitlement = ""
    var mode = "test"
    var error = ""
    var cursor = 0
    while (cursor <= source.size && error == "") {
        var end = cursor
        while (end < source.size && source[end] != 10) end = end + 1
        val line = microTrim(source.slice(cursor, end))
        cursor = end + 1
        if (line != "" && line[0] != 35) {
            var separator = 0
            while (separator < line.size && line[separator] != 58) separator = separator + 1
            if (separator >= line.size) {
                error = "micro.yaml contains a line without a key/value separator."
            } else {
                var key = microTrim(line.slice(0, separator))
                if (key.size > 2 && key.slice(0, 2) == "- ") key = microTrim(key.slice(2, key.size))
                val value = microYamlScalar(line.slice(separator + 1, line.size))
                val startsProduct = line.size >= 2 && line.slice(0, 2) == "- "
                if (startsProduct) {
                    if (productId != "") {
                        var duplicate = false
                        var idIndex = 0
                        while (idIndex < ids.size) {
                            if (ids[idIndex] == productId) duplicate = true
                            idIndex = idIndex + 1
                        }
                        if (!microProductIdValid(productId) || productName == "" || price <= 0 || price > 99999999 ||
                            currency.size != 3 || (productType != "one_time" && productType != "subscription") ||
                            (mode != "test" && mode != "live") || duplicate) {
                            error = "micro.yaml contains an invalid or duplicate product."
                        } else {
                            ids.append(productId)
                            apiProducts.append(microConfiguredProduct(productId, productName, description, price, currency, productType, entitlement, mode, false))
                            bundleProducts.append(microConfiguredProduct(productId, productName, description, price, currency, productType, entitlement, mode, true))
                        }
                    }
                    productId = ""
                    productName = ""
                    description = ""
                    price = 0
                    currency = ""
                    productType = "one_time"
                    entitlement = ""
                    mode = "test"
                    inProducts = true
                }
                if (key == "slug" && !inProducts) slug = value
                else if (key == "products" && !inProducts) inProducts = true
                else if (inProducts && key == "id") productId = value
                else if (inProducts && key == "name") productName = value
                else if (inProducts && key == "description") description = value
                else if (inProducts && key == "price") price = microPositiveInteger(value)
                else if (inProducts && key == "currency") currency = value
                else if (inProducts && key == "type") productType = value
                else if (inProducts && key == "entitlement") entitlement = value
                else if (inProducts && key == "mode") mode = value
                else if (!(key == "products" && value == ""))
                    error = "micro.yaml contains an unsupported key: $key"
            }
        }
    }
    if (error == "" && productId != "") {
        var duplicate = false
        var idIndex = 0
        while (idIndex < ids.size) {
            if (ids[idIndex] == productId) duplicate = true
            idIndex = idIndex + 1
        }
        if (!microProductIdValid(productId) || productName == "" || price <= 0 || price > 99999999 ||
            currency.size != 3 || (productType != "one_time" && productType != "subscription") ||
            (mode != "test" && mode != "live") || duplicate) {
            error = "micro.yaml contains an invalid or duplicate product."
        } else {
            apiProducts.append(microConfiguredProduct(productId, productName, description, price, currency, productType, entitlement, mode, false))
            bundleProducts.append(microConfiguredProduct(productId, productName, description, price, currency, productType, entitlement, mode, true))
        }
    }
    MicroProductDefinitions(error == "", slug, jsonArray(apiProducts), jsonArray(bundleProducts), error)
}

fun microPathSafe(value: string): bool {
    var valid = value != "" && value.size <= 512 && value[0] != 47 &&
        value[value.size - 1] != 47
    var componentBegin = 0
    var index = 0
    while (valid && index <= value.size) {
        if (index == value.size || value[index] == 47) {
            val component = value.slice(componentBegin, index)
            if (component == "" || component == "." || component == ".." ||
                component[0] == 46 || component.size > 128) valid = false
            componentBegin = index + 1
        } else if (value[index] < 32 || value[index] > 126 || value[index] == 92) {
            valid = false
        }
        index = index + 1
    }
    valid
}

fun microMediaType(value: string): string {
    val extension = path(value).extension()
    if (extension == "html" || extension == "htm") "text/html; charset=utf-8"
    else if (extension == "css") "text/css; charset=utf-8"
    else if (extension == "js" || extension == "mjs") "text/javascript; charset=utf-8"
    else if (extension == "json" || extension == "map") "application/json; charset=utf-8"
    else if (extension == "svg") "image/svg+xml"
    else if (extension == "png") "image/png"
    else if (extension == "jpg" || extension == "jpeg") "image/jpeg"
    else if (extension == "gif") "image/gif"
    else if (extension == "webp") "image/webp"
    else if (extension == "ico") "image/x-icon"
    else if (extension == "woff") "font/woff"
    else if (extension == "woff2") "font/woff2"
    else if (extension == "txt") "text/plain; charset=utf-8"
    else "application/octet-stream"
}

fun microAppendProjectFile(
    var files: array<MicroProjectFile>,
    file: MicroProjectFile
): void {
    files.append(file)
    return
}

fun microCollectDirectory(
    directory: Path,
    prefix: string,
    var files: array<MicroProjectFile>
): string {
    var error = ""
    val entries = directory.entries()
    var index = 0
    while (index < entries.size && error == "") {
        val entry = entries[index]
        val relative = if (prefix == "") entry.name() else "$prefix/${entry.name()}"
        val info = entry.info()
        if (!microPathSafe(relative)) {
            error = "Unsafe project path: $relative"
        } else if (info.isDirectory()) {
            error = microCollectDirectory(entry, relative, files)
        } else if (info.isFile()) {
            if (info.size > 4194304) error = "Project file exceeds 4 MiB: $relative"
            else microAppendProjectFile(
                files,
                MicroProjectFile(relative, entry.readText(), microMediaType(relative))
            )
        } else {
            error = "Project entries must be regular files or directories: $relative"
        }
        index = index + 1
    }
    error
}

fun microPublicFiles(root: Path): MicroFileCollection {
    val files: array<MicroProjectFile> = []
    val directory = root.child("public")
    if (!directory.exists()) MicroFileCollection(true, files, "")
    else if (!directory.info().isDirectory())
        MicroFileCollection(false, files, "public must be a directory.")
    else {
        val error = microCollectDirectory(directory, "", files)
        MicroFileCollection(error == "", files, error)
    }
}

fun microDigest(value: string): string = hexEncode(sha256(value))

fun microBundleFile(file: MicroProjectFile): Json = jsonObject(
    ["path", "sha256", "body_base64"],
    [jsonString(file.path), jsonString(microDigest(file.contents)),
     jsonString(base64Encode(file.contents))]
)

fun microBundleAsset(file: MicroProjectFile): Json = jsonObject(
    ["path", "media_type", "sha256", "body_base64"],
    [jsonString(file.path), jsonString(file.mediaType),
     jsonString(microDigest(file.contents)), jsonString(base64Encode(file.contents))]
)

fun microSourceName(name: string): bool {
    val extension = path(name).extension()
    extension == "ab" || name == "micro.yaml" || name == "abla.toml" ||
        name == "abla.lock"
}

fun microIgnoredSourceDirectory(name: string): bool =
    name == "public" || name == ".micro" || name == "build" ||
    name == "target" || name == "node_modules" || name[0] == 46

fun microCollectSourceDirectory(
    directory: Path,
    prefix: string,
    var files: array<MicroProjectFile>
): void {
    val entries = directory.entries()
    var index = 0
    while (index < entries.size) {
        val entry = entries[index]
        val name = entry.name()
        val relative = if (prefix == "") name else "$prefix/$name"
        val info = entry.info()
        if (info.isDirectory() && !microIgnoredSourceDirectory(name)) {
            microCollectSourceDirectory(entry, relative, files)
        } else if (info.isFile() && microSourceName(name) && info.size <= 1048576 &&
            microPathSafe(relative)) {
            microAppendProjectFile(
                files,
                MicroProjectFile(relative, entry.readText(), "text/plain; charset=utf-8")
            )
        }
        index = index + 1
    }
    return
}

fun microSourceFiles(root: Path): array<MicroProjectFile> {
    val files: array<MicroProjectFile> = []
    microCollectSourceDirectory(root, "", files)
    files
}

fun microJsonFiles(files: array<MicroProjectFile>, assets: bool): Json {
    val encoded: array<Json> = []
    var index = 0
    while (index < files.size) {
        encoded.append(if (assets) microBundleAsset(files[index]) else microBundleFile(files[index]))
        index = index + 1
    }
    jsonArray(encoded)
}

fun microCompiler(): string {
    val configured = linuxEnvironment("MICRO_ABLAC")
    if (configured.found && configured.value != "") configured.value else "ablac"
}

fun microCompileServer(root: Path): MicroResult {
    val source = root.child("app.ab")
    if (!source.exists()) return MicroResult(true, "")
    val internal = root.child(".micro")
    if (!internal.createDirectories())
        return MicroResult(false, "Could not create the internal build directory.")
    val projectManifest = root.child("abla.toml")
    val temporaryManifest = !projectManifest.exists()
    val manifest = "compileCapabilities = [\"filesystem.write\"]\n"
    if (temporaryManifest && !projectManifest.writeTextAtomic(manifest))
        return MicroResult(false, "Could not write the internal Abla build manifest.")
    val driver = "import \"abla/wasm/build\"\n\nval built = #wasmBuildModule(\"micro-project-server\", \"app.ab\", \".micro/build/app.wasm\", false, true)\n\nfun main: int = if (built) 0 else 1\n"
    if (!root.child("micro-build.ab").writeTextAtomic(driver))
        return MicroResult(false, "Could not write the temporary Abla build driver.")
    val command = linuxCommand(microCompiler())
    command.argument("build")
    command.argument("micro-build.ab")
    command.argument("-o")
    command.argument(".micro/build-driver")
    command.argument("--no-cache")
    val status = command.run()
    root.child("micro-build.ab").remove()
    if (temporaryManifest) projectManifest.remove()
    if (status == 0 && root.child(".micro/build/app.wasm").exists())
        MicroResult(true, "")
    else MicroResult(false, "The Abla server build failed.")
}

fun microProjectBundle(root: Path): MicroResult {
    val publicFiles = microPublicFiles(root)
    if (!publicFiles.succeeded) return MicroResult(false, publicFiles.message)
    val compiled = microCompileServer(root)
    if (!compiled.succeeded) return compiled
    val definitions = microProductDefinitions(root)
    if (!definitions.succeeded) return MicroResult(false, definitions.message)
    val serverPath = root.child(".micro/build/app.wasm")
    val hasServer = serverPath.info().isFile()
    var hasIndex = false
    var assetIndex = 0
    while (assetIndex < publicFiles.files.size) {
        if (publicFiles.files[assetIndex].path == "index.html") hasIndex = true
        assetIndex = assetIndex + 1
    }
    if (!hasServer && !hasIndex)
        return MicroResult(false, "A project needs public/index.html or app.ab.")
    val server = if (hasServer) {
        val contents = serverPath.readText()
        jsonObject(
            ["abi", "sha256", "body_base64"],
            [jsonString("micro.wasm.v1"), jsonString(microDigest(contents)),
             jsonString(base64Encode(contents))]
        )
    } else jsonNull()
    val bundle = jsonObject(
        ["version", "sdk_version", "source", "server", "assets", "resources"],
        [jsonString("micro.bundle.v1"), jsonString("micro.browser.v1"),
         microJsonFiles(microSourceFiles(root), false), server,
         microJsonFiles(publicFiles.files, true),
         jsonObject(["products"], [definitions.bundleProducts])]
    )
    val encoded = jsonStringify(bundle)
    val target = root.child(".micro/bundle.json")
    if (!target.writeTextAtomic(encoded))
        MicroResult(false, "Could not write .micro/bundle.json.")
    else {
        val digest = microDigest(encoded)
        MicroResult(
            true,
            "Built ${target.text}\nsha256 $digest",
            jsonStringify(jsonObject(
                ["ok", "bundle_path", "bundle_sha256"],
                [jsonBoolean(true), jsonString(target.text), jsonString(digest)]
            ))
        )
    }
}

fun microBuildProject(root: Path): MicroResult = microProjectBundle(root)

fun microContainsSlash(value: string): bool {
    var found = false
    var index = 0
    while (index < value.size) {
        if (value[index] == 47) found = true
        index = index + 1
    }
    found
}

fun microNewProject(directory: string): MicroResult {
    if (!microPathSafe(directory) || microContainsSlash(directory))
        return MicroResult(false, "Project directory must be one safe local name.")
    val root = path(directory)
    if (root.exists()) return MicroResult(false, "$directory already exists.")
    val index = "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>My Micro</title>\n</head>\n<body>\n  <main>\n    <h1>My Micro</h1>\n    <p>Edit public/index.html, then run micro build.</p>\n  </main>\n</body>\n</html>\n"
    val created = root.child("public/index.html").writeTextAtomic(index)
    if (!created) MicroResult(false, "Could not create $directory.")
    else MicroResult(
        true,
        "Created $directory\nRun: cd $directory && micro build",
        jsonStringify(jsonObject(
            ["ok", "directory"], [jsonBoolean(true), jsonString(directory)]
        ))
    )
}
